                    </div>
                    <div class="qisutu-form-field"><label for="qisutu-cmdb-ticket-search">[% Translate.SearchTitle %]</label><input id="qisutu-cmdb-ticket-search" type="search" autocomplete="off" data-qisutu-cmdb-ticket-search data-url="index.pl?Page=AgentTicketZoom&amp;Step=CMDBSearch&amp;TicketID=[% TicketID %]"></div>
                    <div class="qisutu-cmdb-ticket-results" data-qisutu-cmdb-ticket-results></div>
                    <form method="post" action="index.pl" data-qisutu-cmdb-ticket-form><input type="hidden" name="Page" value="AgentTicketZoom"><input type="hidden" name="Step" value="CMDBLink"><input type="hidden" name="TicketID" value="[% TicketID %]"><input type="hidden" name="CIID" value=""></form>
                </div>
            </div>
            [% END %]
