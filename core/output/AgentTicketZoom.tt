            <section class="qisutu-dashboard" aria-labelledby="qisutu-agent-ticket-zoom-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-agent-ticket-zoom-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                    <a class="qisutu-button qisutu-button-secondary" href="[% TicketListURL %]">[% Translate.TicketBackToList %]</a>
                </div>

                [% IF TicketFound %]
                <section class="qisutu-ticket-layout">
                    <article class="qisutu-panel qisutu-ticket-main">
                        <div class="qisutu-panel-header">
                            <h2>[% TicketTitle %]</h2>
                        </div>

                        <div class="qisutu-ticket-meta-grid">
                            <div>
                                <span>[% Translate.TicketNumber %]</span>
                                <strong>[% TicketNumber %]</strong>
                            </div>
                            <div>
                                <span>[% Translate.TicketQueue %]</span>
                                <strong>[% TicketQueue %]</strong>
                            </div>
                            <div>
                                <span>[% Translate.TicketState %]</span>
                                <strong>[% TicketState %]</strong>
                            </div>
                            <div>
                                <span>[% Translate.TicketPriority %]</span>
                                <strong>[% TicketPriority %]</strong>
                            </div>
                            <div>
                                <span>[% Translate.TicketAge %]</span>
                                <strong>[% TicketAge %]</strong>
                            </div>
                        </div>

                        [% IF TicketMerged %]
                        <section class="qisutu-ticket-merged-shell" aria-labelledby="qisutu-ticket-merged-title">
                            <div class="qisutu-ticket-merged-icon" aria-hidden="true">↪</div>
                            <div>
                                <h3 id="qisutu-ticket-merged-title">[% Translate.TicketMergedShellTitle %]</h3>
                                <p>[% Translate.TicketMergedShellText %]</p>
                                [% IF TicketMergedTargetID %]
                                <a class="qisutu-button qisutu-button-primary" href="index.pl?Page=AgentTicketZoom&amp;TicketID=[% TicketMergedTargetID %]">[% Translate.TicketMergedShellLink %] [% TicketMergedTargetNumber %] – [% TicketMergedTargetTitle %]</a>
                                [% END %]
                            </div>
                        </section>
                        [% ELSE %]
                        <section class="qisutu-ticket-reply-top-actions" aria-label="[% Translate.TicketReplyActionsTitle %]">
                            <button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-reply-mode="note" data-qisutu-reply-title="[% Translate.TicketCreateNote %]" data-qisutu-submit-label="[% Translate.TicketArticleSaveNote %]" data-qisutu-scroll-reply="1">[% Translate.TicketCreateNote %]</button>
                            <button class="qisutu-ticket-tools-button" type="button" aria-label="[% Translate.TicketToolsOpen %]" aria-expanded="[% TicketToolsButtonExpanded %]" data-qisutu-ticket-tools-open>
                                <span aria-hidden="true">⚙</span>
                            </button>
                        </section>

                        <section class="qisutu-ticket-tools-overlay [% TicketToolsOverlayClass %]" aria-labelledby="qisutu-ticket-tools-title" aria-hidden="[% TicketToolsOverlayAriaHidden %]" data-qisutu-ticket-tools-overlay data-qisutu-ticket-tools-active="[% TicketToolActive %]">
                            <div class="qisutu-ticket-tools-header">
                                <div>
                                    <h3 id="qisutu-ticket-tools-title">[% Translate.TicketToolsTitle %]</h3>
                                    <p>[% Translate.TicketToolsIntro %]</p>
                                </div>
                                <button class="qisutu-ticket-tools-close" type="button" aria-label="[% Translate.TicketToolsClose %]" data-qisutu-ticket-tools-close>×</button>
                            </div>

                            <div class="qisutu-ticket-tools-grid" role="tablist" aria-label="[% Translate.TicketToolsTitle %]">
                                <button class="qisutu-ticket-tools-tile qisutu-ticket-tools-tile-active" type="button" role="tab" aria-selected="true" data-qisutu-ticket-tool="priority">[% Translate.TicketToolPriority %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="owner">[% Translate.TicketToolOwner %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="responsible">[% Translate.TicketToolResponsible %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="customer">[% Translate.TicketToolCustomer %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="service">[% Translate.TicketToolService %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="queue">[% Translate.TicketToolQueue %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="close">[% Translate.TicketToolClose %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="time-accounting">[% Translate.TimeAccountingTitle %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="link">[% Translate.TicketToolLink %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="merge">[% Translate.TicketToolMerge %]</button>
                                <button class="qisutu-ticket-tools-tile" type="button" role="tab" aria-selected="false" data-qisutu-ticket-tool="history">[% Translate.TicketToolHistory %]</button>
                            </div>

                            <div class="qisutu-ticket-tools-panels">
                                <div class="qisutu-form-error [% TicketToolErrorClass %]">
                                    [% TicketToolError %]
                                </div>

                                <div class="qisutu-ticket-tools-panel" data-qisutu-ticket-tool-panel="priority">
                                    <h4>[% Translate.TicketToolPriority %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketToolUpdate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" name="ToolAction" value="priority">

                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field">
                                                <label for="qisutu-ticket-tool-priority">[% Translate.TicketPriority %]</label>
                                                <select id="qisutu-ticket-tool-priority" name="PriorityID" required>
                                                    [% RAW.TicketPriorityOptionsHTML %]
                                                </select>
                                            </div>
                                            [% RAW.TicketPriorityDynamicFieldsHTML %]
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label for="qisutu-ticket-tool-priority-body">[% Translate.TicketToolInternalArticle %]</label>
                                                <textarea id="qisutu-ticket-tool-priority-body" class="qisutu-richtext" name="ToolArticleBody" rows="5"></textarea>
                                                <p class="qisutu-form-help">[% Translate.TicketToolInternalArticleHelp %]</p>
                                            </div>
                                        </div>

                                        [% RAW.TicketToolPriorityTimeAccountingFieldsHTML %]

                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketToolSaveChange %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="owner">
                                    <h4>[% Translate.TicketToolOwner %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketToolUpdate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" name="ToolAction" value="owner">
                                        <input type="hidden" id="qisutu-ticket-tool-owner-id" name="OwnerUserID" value="" data-qisutu-autocomplete-target>

                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide qisutu-autocomplete">
                                                <label for="qisutu-ticket-tool-owner">[% Translate.TicketOwner %]</label>
                                                <input id="qisutu-ticket-tool-owner" type="text" value="" placeholder="[% Translate.TicketToolOwnerSearchPlaceholder %]" autocomplete="off" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketZoom&amp;Step=AgentLookup&amp;TicketID=[% TicketID %]" data-qisutu-autocomplete-hidden="qisutu-ticket-tool-owner-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]" data-qisutu-autocomplete-reset-on-panel="1">
                                                <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                                <p class="qisutu-form-help">[% Translate.TicketToolAutocompleteHelp %]</p>
                                            </div>
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label for="qisutu-ticket-tool-owner-body">[% Translate.TicketToolInternalArticle %]</label>
                                                <textarea id="qisutu-ticket-tool-owner-body" class="qisutu-richtext" name="ToolArticleBody" rows="5"></textarea>
                                                <p class="qisutu-form-help">[% Translate.TicketToolInternalArticleHelp %]</p>
                                            </div>
                                        </div>

                                        [% RAW.TicketToolOwnerTimeAccountingFieldsHTML %]

                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketToolSaveChange %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="responsible">
                                    <h4>[% Translate.TicketToolResponsible %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketToolUpdate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" name="ToolAction" value="responsible">
                                        <input type="hidden" id="qisutu-ticket-tool-responsible-id" name="ResponsibleUserID" value="" data-qisutu-autocomplete-target>

                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide qisutu-autocomplete">
                                                <label for="qisutu-ticket-tool-responsible">[% Translate.TicketResponsible %]</label>
                                                <input id="qisutu-ticket-tool-responsible" type="text" value="" placeholder="[% Translate.TicketToolResponsibleSearchPlaceholder %]" autocomplete="off" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketZoom&amp;Step=AgentLookup&amp;TicketID=[% TicketID %]" data-qisutu-autocomplete-hidden="qisutu-ticket-tool-responsible-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]" data-qisutu-autocomplete-reset-on-panel="1">
                                                <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                                <p class="qisutu-form-help">[% Translate.TicketToolAutocompleteHelp %]</p>
                                            </div>
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label for="qisutu-ticket-tool-responsible-body">[% Translate.TicketToolInternalArticle %]</label>
                                                <textarea id="qisutu-ticket-tool-responsible-body" class="qisutu-richtext" name="ToolArticleBody" rows="5"></textarea>
                                                <p class="qisutu-form-help">[% Translate.TicketToolInternalArticleHelp %]</p>
                                            </div>
                                        </div>

                                        [% RAW.TicketToolResponsibleTimeAccountingFieldsHTML %]

                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketToolSaveChange %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="customer">
                                    <h4>[% Translate.TicketToolCustomer %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketToolUpdate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" name="ToolAction" value="customer">
                                        <input type="hidden" id="qisutu-ticket-tool-customer-user-id" name="CustomerUserID" value="" data-qisutu-autocomplete-target>

                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide qisutu-autocomplete">
                                                <label for="qisutu-ticket-tool-customer-user">[% Translate.TicketCustomerUser %]</label>
                                                <input id="qisutu-ticket-tool-customer-user" type="text" value="" placeholder="[% Translate.TicketToolCustomerSearchPlaceholder %]" autocomplete="off" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketZoom&amp;Step=CustomerUserLookup&amp;TicketID=[% TicketID %]" data-qisutu-autocomplete-hidden="qisutu-ticket-tool-customer-user-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]" data-qisutu-autocomplete-reset-on-panel="1">
                                                <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                                <p class="qisutu-form-help">[% Translate.TicketToolCustomerSearchHelp %]</p>
                                            </div>
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label for="qisutu-ticket-tool-customer-body">[% Translate.TicketToolInternalArticle %]</label>
                                                <textarea id="qisutu-ticket-tool-customer-body" class="qisutu-richtext" name="ToolArticleBody" rows="5"></textarea>
                                                <p class="qisutu-form-help">[% Translate.TicketToolInternalArticleHelp %]</p>
                                            </div>
                                        </div>

                                        [% RAW.TicketToolCustomerTimeAccountingFieldsHTML %]

                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketToolSaveChange %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="service">
                                    <h4>[% Translate.TicketServiceChange %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketToolUpdate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" name="ToolAction" value="service">

                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label for="qisutu-ticket-tool-service">[% Translate.TicketService %]</label>
                                                <select id="qisutu-ticket-tool-service" name="ServiceID" data-qisutu-service-tree>
                                                    [% RAW.TicketServiceOptionsHTML %]
                                                </select>
                                                <p class="qisutu-form-help">[% Translate.TicketServiceOptional %]</p>
                                            </div>
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label for="qisutu-ticket-tool-service-body">[% Translate.TicketToolInternalArticle %]</label>
                                                <textarea id="qisutu-ticket-tool-service-body" class="qisutu-richtext" name="ToolArticleBody" rows="5" required></textarea>
                                                <p class="qisutu-form-help">[% Translate.TicketToolInternalArticleHelp %]</p>
                                            </div>
                                        </div>

                                        [% RAW.TicketToolServiceTimeAccountingFieldsHTML %]

                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketToolSaveChange %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="queue">
                                    <h4>[% Translate.TicketToolQueue %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketToolUpdate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" name="ToolAction" value="queue">

                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field">
                                                <label for="qisutu-ticket-tool-queue">[% Translate.TicketQueue %]</label>
                                                <select id="qisutu-ticket-tool-queue" name="QueueID" required data-qisutu-ticket-tool-queue data-qisutu-dynamic-fields-url="index.pl?Page=AgentTicketZoom&amp;Step=DynamicFields&amp;TicketID=[% TicketID %]">
                                                    [% RAW.TicketQueueOptionsHTML %]
                                                </select>
                                            </div>
                                            <div class="qisutu-ticket-tools-form-wide" data-qisutu-ticket-tool-queue-dynamic-fields>[% RAW.TicketQueueDynamicFieldsHTML %]</div>
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label for="qisutu-ticket-tool-queue-body">[% Translate.TicketToolInternalArticle %]</label>
                                                <textarea id="qisutu-ticket-tool-queue-body" class="qisutu-richtext" name="ToolArticleBody" rows="5"></textarea>
                                                <p class="qisutu-form-help">[% Translate.TicketToolInternalArticleHelp %]</p>
                                            </div>
                                        </div>

                                        [% RAW.TicketToolQueueTimeAccountingFieldsHTML %]

                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketToolSaveChange %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="close">
                                    <h4>[% Translate.TicketToolClose %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketToolUpdate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" name="ToolAction" value="close">

                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field">
                                                <label for="qisutu-ticket-tool-close-state">[% Translate.TicketState %]</label>
                                                <select id="qisutu-ticket-tool-close-state" name="ClosedStateID" required>
                                                    [% RAW.TicketClosedStateOptionsHTML %]
                                                </select>
                                            </div>
                                            [% RAW.TicketCloseDynamicFieldsHTML %]
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label for="qisutu-ticket-tool-close-body">[% Translate.TicketToolInternalArticle %]</label>
                                                <textarea id="qisutu-ticket-tool-close-body" class="qisutu-richtext" name="ToolArticleBody" rows="5"></textarea>
                                                <p class="qisutu-form-help">[% Translate.TicketToolInternalArticleHelp %]</p>
                                            </div>
                                        </div>

                                        [% RAW.TicketToolCloseTimeAccountingFieldsHTML %]

                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketToolCloseSubmit %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="time-accounting">
                                    <h4>[% Translate.TimeAccountingManualEntry %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TimeAccountingCreate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <div class="qisutu-form-field">
                                            <label for="qisutu-ticket-manual-time-description">[% Translate.TimeAccountingDescription %] *</label>
                                            <textarea id="qisutu-ticket-manual-time-description" name="TimeAccountingDescription" rows="4" required>[% ManualTimeAccountingDescription %]</textarea>
                                        </div>
                                        [% RAW.ManualTimeAccountingFieldsHTML %]
                                        <div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TimeAccountingSave %]</button></div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="link">
                                    <h4>[% Translate.TicketToolLink %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketLinkCreate">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" id="qisutu-ticket-tool-link-id" name="TargetTicketID" value="" data-qisutu-autocomplete-target>
                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide qisutu-autocomplete">
                                                <label for="qisutu-ticket-tool-link-number">[% Translate.TicketToolTicketNumber %]</label>
                                                <input id="qisutu-ticket-tool-link-number" type="text" autocomplete="off" placeholder="[% Translate.TicketLinkSearchPlaceholder %]" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketZoom&amp;Step=TicketLookup&amp;TicketID=[% TicketID %]" data-qisutu-autocomplete-hidden="qisutu-ticket-tool-link-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]" data-qisutu-autocomplete-reset-on-panel="1" required>
                                                <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                                <p class="qisutu-form-help">[% Translate.TicketLinkHelp %]</p>
                                            </div>
                                        </div>
                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketLinkSubmit %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="merge">
                                    <h4>[% Translate.TicketToolMerge %]</h4>
                                    <form method="post" action="index.pl" data-qisutu-ticket-tool-form data-qisutu-merge-form>
                                        <input type="hidden" name="Page" value="AgentTicketZoom">
                                        <input type="hidden" name="Step" value="TicketMerge">
                                        <input type="hidden" name="TicketID" value="[% TicketID %]">
                                        <input type="hidden" id="qisutu-ticket-tool-merge-id" name="TargetTicketID" value="[% MergeTargetTicketID %]" data-qisutu-autocomplete-target>
                                        <div class="qisutu-ticket-tools-form-grid">
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide qisutu-autocomplete">
                                                <label for="qisutu-ticket-tool-merge-number">[% Translate.TicketToolTargetTicketNumber %]</label>
                                                <input id="qisutu-ticket-tool-merge-number" type="text" name="TargetTicketQuery" value="[% MergeTargetTicketQuery %]" autocomplete="off" placeholder="[% Translate.TicketLinkSearchPlaceholder %]" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketZoom&amp;Step=TicketLookup&amp;TicketID=[% TicketID %]&amp;ExcludeMerged=1" data-qisutu-autocomplete-hidden="qisutu-ticket-tool-merge-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]" data-qisutu-autocomplete-reset-on-panel="1" required>
                                                <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                                <p class="qisutu-form-help">[% Translate.TicketMergeHelp %]</p>
                                            </div>
                                            <fieldset class="qisutu-ticket-merge-direction qisutu-ticket-tools-form-wide">
                                                <legend>[% Translate.TicketMergeDirection %]</legend>
                                                <label>
                                                    <input type="radio" name="MergeDirection" value="current_into_selected" [% MergeDirectionCurrentChecked %] required>
                                                    <span><strong>[% TicketNumber %]</strong> [% Translate.TicketMergeDirectionCurrentIntoSelected %]</span>
                                                </label>
                                                <label>
                                                    <input type="radio" name="MergeDirection" value="selected_into_current" [% MergeDirectionSelectedChecked %] required>
                                                    <span>[% Translate.TicketMergeDirectionSelectedIntoCurrent %] <strong>[% TicketNumber %]</strong></span>
                                                </label>
                                            </fieldset>
                                            <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                                <label class="qisutu-form-checkbox" for="qisutu-ticket-tool-merge-confirm">
                                                    <input id="qisutu-ticket-tool-merge-confirm" type="checkbox" name="MergeConfirmed" value="1" required>
                                                    <span>[% Translate.TicketMergeConfirmation %]</span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="qisutu-form-actions">
                                            <button class="qisutu-button qisutu-button-danger" type="submit">[% Translate.TicketMergeSubmit %]</button>
                                        </div>
                                    </form>
                                </div>

                                <div class="qisutu-ticket-tools-panel qisutu-hidden" data-qisutu-ticket-tool-panel="history">
                                    <h4>[% Translate.TicketToolHistory %]</h4>
                                    <div class="qisutu-ticket-history" data-qisutu-ticket-history data-qisutu-ticket-history-url="index.pl?Page=AgentTicketZoom&amp;Step=TicketHistory&amp;TicketID=[% TicketID %]" data-qisutu-ticket-history-error="[% Translate.TicketHistoryLoadError %]" data-qisutu-ticket-history-loading="[% Translate.TicketHistoryLoading %]">
                                        <div class="qisutu-ticket-history-filters" role="group" aria-label="[% Translate.TicketHistoryFilterLabel %]">
                                            <button class="qisutu-button qisutu-button-secondary qisutu-button-small qisutu-ticket-history-filter-active" type="button" data-qisutu-ticket-history-filter="all" aria-pressed="true">[% Translate.TicketHistoryFilterAll %]</button>
                                            <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-ticket-history-filter="change" aria-pressed="false">[% Translate.TicketHistoryFilterChanges %]</button>
                                            <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-ticket-history-filter="communication" aria-pressed="false">[% Translate.TicketHistoryFilterCommunication %]</button>
                                            <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-ticket-history-filter="time" aria-pressed="false">[% Translate.TicketHistoryFilterTime %]</button>
                                            <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-ticket-history-filter="system" aria-pressed="false">[% Translate.TicketHistoryFilterSystem %]</button>
                                        </div>
                                        <div class="qisutu-ticket-history-list" data-qisutu-ticket-history-list aria-live="polite">[% RAW.TicketHistoryHTML %]</div>
                                        <div class="qisutu-ticket-history-actions">
                                            <button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-ticket-history-more data-before-id="[% TicketHistoryNextBeforeID %]" [% TicketHistoryLoadMoreHidden %]>[% Translate.TicketHistoryLoadMore %]</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="qisutu-ticket-articles" aria-labelledby="qisutu-ticket-articles-title">
                            <div class="qisutu-ticket-articles-header">
                                <h3 id="qisutu-ticket-articles-title">[% Translate.TicketArticlesTitle %]</h3>
                                <div class="qisutu-ticket-article-controls">
                                    <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-articles-open-all>[% Translate.TicketArticlesOpenAll %]</button>
                                    <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-articles-close-all>[% Translate.TicketArticlesCloseAll %]</button>
                                    <span class="qisutu-panel-counter">[% ArticleCount %]</span>
                                </div>
                            </div>

                            <div class="qisutu-ticket-article-list">
                                [% FOREACH Article IN ArticleList %]
                                <article id="qisutu-ticket-article-[% Article.id %]" class="qisutu-ticket-article [% Article.article_open_class %] [% Article.article_sender_class %]" data-qisutu-ticket-article>
                                    <div class="qisutu-ticket-article-shell">
                                        <div class="qisutu-ticket-article-avatar" title="[% Article.sender_role_label %]">[% Article.sender_initials %]</div>

                                        <div class="qisutu-ticket-article-bubble">
                                            <div class="qisutu-ticket-article-summary">
                                                <button class="qisutu-ticket-article-toggle" type="button" data-qisutu-article-toggle>
                                                    <div class="qisutu-ticket-article-headline">
                                                        <span class="qisutu-ticket-article-sender">[% Article.sender_name %]</span>
                                                        <strong>[% Article.subject %]</strong>
                                                        <span>[% Article.created_at_display %]</span>
                                                    </div>
                                                </button>

                                                <div class="qisutu-ticket-article-side">
                                                    <span class="qisutu-ticket-article-badges">
                                                        <span class="qisutu-ticket-article-role">[% Article.sender_role_label %]</span>
                                                        <span class="qisutu-ticket-article-label">[% Article.visibility_label %]</span>
                                                        <a class="qisutu-ticket-article-origin [% Article.origin_class %]" href="index.pl?Page=AgentTicketZoom&amp;TicketID=[% Article.origin_ticket_id %]" title="[% Article.origin_title %]">[% Article.origin_label %] [% Article.origin_ticket_number %]</a>
                                                    </span>

                                                    <div class="qisutu-ticket-article-top-actions">
                                                        <button class="qisutu-button qisutu-button-secondary qisutu-button-small [% Article.reply_button_class %]" type="button" data-qisutu-article-reply-button data-qisutu-reply-article-id="[% Article.id %]" data-qisutu-reply-to="[% Article.reply_to %]" data-qisutu-reply-cc="[% Article.reply_cc %]" data-qisutu-reply-subject="[% Article.reply_subject %]">[% Translate.TicketReplyCustomer %]</button>
                                                        <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-article-forward-button data-qisutu-forward-article-id="[% Article.id %]" data-qisutu-forward-subject="[% Article.forward_subject %]" data-qisutu-forward-title="[% Translate.TicketToolForward %]" data-qisutu-forward-submit-label="[% Translate.TicketToolForwardSend %]">[% Translate.TicketToolForward %]</button>
                                                        <button class="qisutu-button qisutu-button-secondary qisutu-button-small [% Article.split_button_class %]" type="button" data-qisutu-article-split-button data-qisutu-split-article-id="[% Article.id %]" data-qisutu-split-title="[% Article.split_title %]">[% Translate.TicketArticleSplit %]</button>
                                                    </div>
                                                </div>
                                            </div>

                                            <textarea class="qisutu-hidden" data-qisutu-article-reply-template>[% Article.reply_body_template %]</textarea>
                                            <textarea class="qisutu-hidden" data-qisutu-article-forward-template>[% Article.forward_body_template %]</textarea>

                                            <div class="qisutu-ticket-article-content">
                                                <dl class="qisutu-ticket-article-meta">
                                                    <dt>[% Translate.TicketArticleFrom %]</dt>
                                                    <dd>[% Article.sender_name %]</dd>
                                                    <dt>[% Translate.TicketArticleTo %]</dt>
                                                    <dd>[% Article.recipient %]</dd>
                                                    <dt>[% Translate.TicketArticleChannel %]</dt>
                                                    <dd>[% Article.channel %]</dd>
                                                </dl>

                                                [% RAW.Article.attachments_html %]

                                                <div class="qisutu-ticket-article-body qisutu-richtext-output">[% RAW.Article.body_html %]</div>

                                            </div>
                                        </div>
                                    </div>
                                </article>
                                [% END %]
                            </div>

                            <div class="qisutu-empty qisutu-ticket-article-empty [% ArticleEmptyClass %]">
                                <strong>[% Translate.TicketArticlesEmptyTitle %]</strong>
                                <p>[% Translate.TicketArticlesEmptyText %]</p>
                            </div>

                            <div class="qisutu-ticket-articles-footer">
                                <div class="qisutu-ticket-article-controls">
                                    <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-articles-open-all>[% Translate.TicketArticlesOpenAll %]</button>
                                    <button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="button" data-qisutu-articles-close-all>[% Translate.TicketArticlesCloseAll %]</button>
                                </div>
                            </div>
                        </section>

                        <dialog class="qisutu-ticket-split-dialog" data-qisutu-ticket-split-dialog [% SplitDialogOpen %]>
                            <form method="post" action="index.pl" data-qisutu-ticket-split-form>
                                <input type="hidden" name="Page" value="AgentTicketZoom">
                                <input type="hidden" name="Step" value="TicketArticleSplit">
                                <input type="hidden" name="TicketID" value="[% TicketID %]">
                                <input type="hidden" name="SourceArticleID" value="[% SplitArticleID %]" data-qisutu-split-article-id>

                                <div class="qisutu-dialog-header">
                                    <div>
                                        <h3>[% Translate.TicketArticleSplitTitle %]</h3>
                                        <p>[% Translate.TicketArticleSplitIntro %]</p>
                                    </div>
                                    <button class="qisutu-ticket-tools-close" type="button" aria-label="[% Translate.CommonClose %]" data-qisutu-ticket-split-close>×</button>
                                </div>

                                <div class="qisutu-form-error [% SplitActionErrorClass %]">[% SplitActionError %]</div>

                                <div class="qisutu-ticket-tools-form-grid">
                                    <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                        <label for="qisutu-ticket-split-title">[% Translate.TicketTitle %] *</label>
                                        <input id="qisutu-ticket-split-title" type="text" name="SplitTitle" value="[% SplitTitle %]" maxlength="500" required data-qisutu-split-title>
                                    </div>
                                    <div class="qisutu-form-field">
                                        <label for="qisutu-ticket-split-queue">[% Translate.TicketQueue %] *</label>
                                        <select id="qisutu-ticket-split-queue" name="SplitQueueID" required>[% RAW.SplitQueueOptionsHTML %]</select>
                                    </div>
                                    <div class="qisutu-form-field">
                                        <label for="qisutu-ticket-split-state">[% Translate.TicketState %] *</label>
                                        <select id="qisutu-ticket-split-state" name="SplitStateID" required>[% RAW.SplitStateOptionsHTML %]</select>
                                    </div>
                                    <div class="qisutu-form-field">
                                        <label for="qisutu-ticket-split-priority">[% Translate.TicketPriority %] *</label>
                                        <select id="qisutu-ticket-split-priority" name="SplitPriorityID" required>[% RAW.SplitPriorityOptionsHTML %]</select>
                                    </div>
                                    <div class="qisutu-form-field qisutu-autocomplete">
                                        <label for="qisutu-ticket-split-owner">[% Translate.TicketOwner %] *</label>
                                        <input type="hidden" id="qisutu-ticket-split-owner-id" name="SplitOwnerUserID" value="[% SplitOwnerUserID %]" data-qisutu-autocomplete-target>
                                        <input id="qisutu-ticket-split-owner" type="text" name="SplitOwnerValue" value="[% SplitOwnerValue %]" autocomplete="off" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketZoom&amp;Step=AgentLookup&amp;TicketID=[% TicketID %]" data-qisutu-autocomplete-hidden="qisutu-ticket-split-owner-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]" required>
                                        <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                    </div>
                                    <div class="qisutu-form-field qisutu-autocomplete">
                                        <label for="qisutu-ticket-split-responsible">[% Translate.TicketResponsible %]</label>
                                        <input type="hidden" id="qisutu-ticket-split-responsible-id" name="SplitResponsibleUserID" value="[% SplitResponsibleUserID %]" data-qisutu-autocomplete-target>
                                        <input id="qisutu-ticket-split-responsible" type="text" name="SplitResponsibleValue" value="[% SplitResponsibleValue %]" autocomplete="off" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketZoom&amp;Step=AgentLookup&amp;TicketID=[% TicketID %]" data-qisutu-autocomplete-hidden="qisutu-ticket-split-responsible-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]">
                                        <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                    </div>
                                    <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                        <dl class="qisutu-ticket-info-list qisutu-ticket-split-customer">
                                            <div class="qisutu-ticket-info-row"><dt>[% Translate.TicketCustomer %]</dt><dd>[% TicketCustomer %]</dd></div>
                                            <div class="qisutu-ticket-info-row"><dt>[% Translate.TicketCustomerUser %]</dt><dd>[% TicketCustomerUser %]</dd></div>
                                        </dl>
                                        <p class="qisutu-form-help">[% Translate.TicketSplitCustomerInherited %]</p>
                                    </div>
                                    <div class="qisutu-form-field qisutu-ticket-tools-form-wide">
                                        <label class="qisutu-form-checkbox" for="qisutu-ticket-split-attachments">
                                            <input id="qisutu-ticket-split-attachments" type="checkbox" name="SplitCopyAttachments" value="1" [% SplitCopyAttachmentsChecked %]>
                                            <span>[% Translate.TicketSplitCopyAttachments %]</span>
                                        </label>
                                        <p class="qisutu-form-help">[% Translate.TicketSplitNoNotifications %]</p>
                                    </div>
                                </div>

                                <div class="qisutu-form-actions">
                                    <button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-ticket-split-close>[% Translate.CommonCancel %]</button>
                                    <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketSplitSubmit %]</button>
                                </div>
                            </form>
                        </dialog>

                        <section class="qisutu-ticket-reply" aria-label="[% Translate.TicketReplyActionsTitle %]">
                            <div class="qisutu-ticket-reply-actions">
                                <button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-reply-mode="note" data-qisutu-reply-title="[% Translate.TicketCreateNote %]" data-qisutu-submit-label="[% Translate.TicketArticleSaveNote %]">[% Translate.TicketCreateNote %]</button>
                                <button class="qisutu-ticket-tools-button" type="button" aria-label="[% Translate.TicketToolsOpen %]" aria-expanded="[% TicketToolsButtonExpanded %]" data-qisutu-ticket-tools-open>
                                    <span aria-hidden="true">⚙</span>
                                </button>
                            </div>

                            <div class="qisutu-form-error [% ArticleCreateErrorClass %]">
                                [% ArticleCreateError %]
                            </div>

                            <form class="qisutu-ticket-reply-form [% ArticleReplyFormClass %]" method="post" action="[% ArticleFormAction %]" enctype="multipart/form-data" data-qisutu-ticket-reply-form>
                                <input type="hidden" name="Page" value="AgentTicketZoom">
                                <input type="hidden" name="Step" value="ArticleCreate">
                                <input type="hidden" name="TicketID" value="[% TicketID %]">
                                <input type="hidden" name="ArticleMode" value="[% DefaultArticleMode %]" data-qisutu-article-mode>
                                <input type="hidden" name="ReplyArticleID" value="" data-qisutu-reply-article-id>

                                <h3 class="qisutu-ticket-reply-form-title" data-qisutu-reply-form-title>[% ReplyFormDefaultTitle %]</h3>

                                <div class="qisutu-form-field">
                                    <label for="qisutu-article-subject">[% Translate.TicketArticleSubject %]</label>
                                    <input id="qisutu-article-subject" type="text" name="Subject" value="[% SubmittedArticleSubject %]">
                                </div>

                                <div class="qisutu-ticket-reply-recipient-grid qisutu-hidden" data-qisutu-email-recipient-fields>
                                    <div class="qisutu-form-field">
                                        <label for="qisutu-article-reply-to">[% Translate.TicketArticleReplyTo %]</label>
                                        <input id="qisutu-article-reply-to" type="text" name="ReplyTo" value="[% SubmittedReplyTo %]" autocomplete="off" placeholder="name@example.com" data-qisutu-reply-to-input>
                                        <p class="qisutu-form-help">[% Translate.TicketArticleReplyToHelp %]</p>
                                    </div>
                                    <div class="qisutu-form-field">
                                        <label for="qisutu-article-reply-cc">[% Translate.TicketArticleReplyCc %]</label>
                                        <input id="qisutu-article-reply-cc" type="text" name="ReplyCc" value="[% SubmittedReplyCc %]" autocomplete="off" placeholder="name@example.com" data-qisutu-reply-cc-input>
                                        <p class="qisutu-form-help">[% Translate.TicketArticleReplyCcHelp %]</p>
                                    </div>
                                </div>

                                <div class="qisutu-form-field [% ResponseTemplateFieldClass %]" data-qisutu-response-template-field>
                                    <label for="qisutu-response-template-select">[% Translate.TicketResponseTemplate %]</label>
                                    <select id="qisutu-response-template-select" name="ResponseTemplateID" data-qisutu-response-template-select data-qisutu-ticket-id="[% TicketID %]">
                                        <option value="">[% Translate.TicketResponseTemplateNone %]</option>
                                        [% FOREACH ResponseTemplate IN TicketResponseTemplateList %]
                                        <option value="[% ResponseTemplate.id %]" [% ResponseTemplate.selected %]>[% ResponseTemplate.name %]</option>
                                        [% END %]
                                    </select>
                                    <p class="qisutu-form-help">[% Translate.TicketResponseTemplateHelp %]</p>
                                    <p class="qisutu-form-error qisutu-hidden" data-qisutu-response-template-error>[% Translate.TicketResponseTemplateLoadFailed %]</p>
                                </div>

                                <div data-qisutu-response-template-hidden-inputs>
                                    [% IF SubmittedResponseTemplateAttachmentSelection %]
                                    <input type="hidden" name="ResponseTemplateAttachmentSelection" value="1">
                                    [% END %]
                                    [% FOREACH AttachmentID IN SubmittedResponseTemplateAttachmentIDs %]
                                    <input type="hidden" name="ResponseTemplateAttachmentID" value="[% AttachmentID %]">
                                    [% END %]
                                </div>

                                <div class="qisutu-form-field">
                                    <label for="qisutu-ticket-status">[% Translate.TicketStatusAfterSubmit %]</label>
                                    <select id="qisutu-ticket-status" name="StatusID" data-qisutu-ticket-status>
                                        [% RAW.TicketStatusOptionsHTML %]
                                    </select>
                                </div>

                                <div class="qisutu-form-field qisutu-hidden" data-qisutu-pending-until-field>
                                    <label for="qisutu-ticket-pending-until">[% Translate.TicketPendingUntil %]</label>
                                    <input id="qisutu-ticket-pending-until" type="datetime-local" name="PendingUntil" value="[% SubmittedPendingUntil %]">
                                    <p class="qisutu-form-help">[% Translate.TicketPendingUntilHelp %]</p>
                                </div>

                                <div data-qisutu-ticket-article-dynamic-fields>[% RAW.TicketArticleDynamicFieldsHTML %]</div>

                                <div class="qisutu-form-field">
                                    <label for="qisutu-article-body">[% Translate.TicketArticleBody %]</label>
                                    <textarea id="qisutu-article-body" class="qisutu-richtext" name="Body" rows="7">[% SubmittedArticleBody %]</textarea>
                                    [% IF HasKnowledgeAccess %]
                                    <div class="qisutu-knowledge-insert-toolbar" data-qisutu-knowledge-insert data-editor="#qisutu-article-body" data-context="ticket_reply" data-ticket-id="[% TicketID %]" data-search-url="index.pl?Page=AgentKnowledgeBase&amp;Step=SearchJSON" data-article-url="index.pl?Page=AgentKnowledgeBase&amp;Step=ArticleGetJSON" data-usage-url="index.pl?Page=AgentKnowledgeBase&amp;Step=UsageRecord" data-queue-id="[% TicketQueueID %]" data-customer-id="[% TicketCustomerID %]" data-mode-selector="[data-qisutu-article-mode]" data-customer-visible-selector="[data-qisutu-note-customer-visible]" data-title-selector="#qisutu-article-subject" data-loading-text="[% Translate.KnowledgeInsertLoading %]" data-empty-text="[% Translate.KnowledgeInsertNoResults %]" data-error-text="[% Translate.KnowledgeInsertError %]" data-not-allowed-text="[% Translate.KnowledgeInsertRestricted %]">
                                        <button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-knowledge-open>[% Translate.KnowledgeInsertOpen %]</button>
                                        <span class="qisutu-form-hint">[% Translate.KnowledgeInsertHelp %]</span>
                                        <div class="qisutu-overlay qisutu-knowledge-insert-overlay" data-qisutu-knowledge-overlay hidden aria-hidden="true">
                                            <div class="qisutu-overlay-dialog qisutu-knowledge-insert-dialog" role="dialog" aria-modal="true" aria-labelledby="qisutu-knowledge-reply-dialog-title">
                                                <div class="qisutu-overlay-header"><div><h2 id="qisutu-knowledge-reply-dialog-title">[% Translate.KnowledgeInsertTitle %]</h2><p>[% Translate.KnowledgeInsertDescription %]</p></div><button class="qisutu-overlay-close" type="button" data-qisutu-knowledge-close aria-label="[% Translate.AdminClose %]">×</button></div>
                                                <div class="qisutu-knowledge-insert-search"><label for="qisutu-knowledge-reply-search">[% Translate.SearchTitle %]</label><input id="qisutu-knowledge-reply-search" type="search" data-qisutu-knowledge-search placeholder="[% Translate.KnowledgeSearchPlaceholder %]" autocomplete="off"></div>
                                                <div class="qisutu-knowledge-insert-status" data-qisutu-knowledge-status aria-live="polite"></div>
                                                <div class="qisutu-knowledge-insert-layout"><div class="qisutu-knowledge-results" data-qisutu-knowledge-results></div><article class="qisutu-knowledge-preview" data-qisutu-knowledge-preview hidden><h3 data-qisutu-knowledge-preview-title></h3><p class="qisutu-knowledge-preview-meta" data-qisutu-knowledge-preview-meta></p><div class="qisutu-rich-content qisutu-knowledge-preview-content" data-qisutu-knowledge-preview-content></div></article></div>
                                                <div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-knowledge-close>[% Translate.AdminCancel %]</button><button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-knowledge-insert-mode="link" disabled>[% Translate.KnowledgeInsertLink %]</button><button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-knowledge-insert-mode="title_solution" disabled>[% Translate.KnowledgeInsertTitleSolution %]</button><button class="qisutu-button qisutu-button-primary" type="button" data-qisutu-knowledge-insert-mode="solution" disabled>[% Translate.KnowledgeInsertSolution %]</button></div>
                                            </div>
                                        </div>
                                    </div>
                                    [% END %]
                                </div>

                                <div class="qisutu-form-field qisutu-ticket-reply-attachments" data-qisutu-attachment-field>
                                    <label for="qisutu-article-attachments">[% Translate.TicketArticleAttachments %]</label>
                                    <input id="qisutu-article-attachments" type="file" name="ArticleAttachment" multiple data-qisutu-attachment-input data-qisutu-attachment-max-bytes="[% AttachmentMaxSizeBytes %]" data-qisutu-attachment-max-label="[% AttachmentMaxSizeMB %] MB">
                                    <div class="qisutu-response-template-reply-attachments qisutu-hidden" data-qisutu-response-template-attachment-wrap>
                                        <strong>[% Translate.TicketResponseTemplateAttachmentsTitle %]</strong>
                                        <div data-qisutu-response-template-attachment-list data-qisutu-response-template-remove-label="[% Translate.TicketResponseTemplateAttachmentRemove %]"></div>
                                    </div>
                                    <div class="qisutu-ticket-reply-attachment-list" data-qisutu-attachment-list data-qisutu-attachment-remove-label="[% Translate.TicketArticleAttachmentRemove %]">
                                        <p class="qisutu-form-hint" data-qisutu-attachment-empty>[% Translate.TicketArticleAttachmentsEmpty %]</p>
                                    </div>
                                    <p class="qisutu-form-help">[% Translate.TicketArticleAttachmentsHelp %]</p>
                                    <p class="qisutu-form-help">[% Translate.TicketArticleAttachmentLimitHelp %] [% AttachmentMaxSizeMB %] MB</p>
                                </div>

                                <div class="qisutu-form-field qisutu-hidden" data-qisutu-note-customer-visible-field>
                                    <label class="qisutu-form-checkbox" for="qisutu-note-customer-visible">
                                        <input id="qisutu-note-customer-visible" type="checkbox" name="CustomerVisible" value="1" data-qisutu-note-customer-visible>
                                        <span>[% Translate.TicketArticleAlsoVisibleForCustomer %]</span>
                                    </label>
                                </div>

                                [% RAW.ArticleTimeAccountingFieldsHTML %]

                                <div class="qisutu-form-actions">
                                    <button class="qisutu-button qisutu-button-primary" type="submit" data-qisutu-reply-submit data-qisutu-email-submit-label="[% Translate.TicketArticleSendEmail %]">[% ReplySubmitDefaultLabel %]</button>
                                </div>
                            </form>

                            <div class="qisutu-attachment-limit-overlay" data-qisutu-attachment-limit-overlay hidden aria-hidden="true">
                                <div class="qisutu-attachment-limit-dialog" role="alertdialog" aria-modal="true" aria-labelledby="qisutu-attachment-limit-title">
                                    <h3 id="qisutu-attachment-limit-title">[% Translate.TicketArticleAttachmentTooLargeTitle %]</h3>
                                    <p data-qisutu-attachment-limit-message data-qisutu-message-template="[% Translate.TicketArticleAttachmentTooLargeMessage %]"></p>
                                    <p>[% Translate.TicketArticleAttachmentTooLargeAdmin %]</p>
                                    <div class="qisutu-form-actions">
                                        <button class="qisutu-button qisutu-button-primary" type="button" data-qisutu-attachment-limit-close>[% Translate.TicketArticleAttachmentDialogOK %]</button>
                                    </div>
                                </div>
                            </div>
                        </section>
                        [% END %]
                    </article>

