            <section class="qisutu-dashboard" aria-labelledby="qisutu-admin-master-data-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-admin-master-data-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                </div>

                <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>

                [% IF HasContentLanguages %]
                <form class="qisutu-localized-content-language" method="get" action="[% FormAction %]" data-localized-content-language-form>
                    <input type="hidden" name="Page" value="[% PageName %]">
                    [% IF ShowCreate %]<input type="hidden" name="Action" value="Create">[% END %]
                    [% IF ShowEdit %]
                    <input type="hidden" name="Action" value="Edit">
                    <input type="hidden" name="ItemID" value="[% ItemID %]">
                    [% END %]
                    <div class="qisutu-form-field">
                        <label for="qisutu-localized-content-language">[% Translate.AdminTranslationLanguage %]</label>
                        <select id="qisutu-localized-content-language" name="ContentLanguage" data-localized-content-language>
                            [% RAW.ContentLanguageOptionsHTML %]
                        </select>
                    </div>
                    <button class="qisutu-button qisutu-button-secondary" type="submit">[% Translate.AdminFilterApply %]</button>
                </form>
                [% END %]

                [% IF ShowList %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% ListTitle %]</h2>
                            <span class="qisutu-panel-subtitle">[% ItemCount %] [% Translate.AdminEntries %]</span>
                        </div>
                        <div class="qisutu-panel-actions">
                            <a class="qisutu-button qisutu-button-primary" href="index.pl?Page=[% PageName %];Action=Create;ContentLanguage=[% CurrentContentLanguage %]">[% CreateTitle %]</a>
                        </div>
                    </div>

                    <div class="qisutu-table-wrap">
                        <table class="qisutu-table qisutu-table-compact">
                            <thead>
                                <tr>
                                    <th>[% Translate.AdminName %]</th>
                                    <th>[% ValueLabel %]</th>
                                    <th>[% Translate.AdminActive %]</th>
                                    <th>[% Translate.AdminSortOrder %]</th>
                                    <th>[% Translate.AdminAction %]</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH Item IN ItemList %]
                                <tr>
                                    <td><a class="qisutu-table-link" href="index.pl?Page=[% PageName %];Action=Edit;ItemID=[% Item.id %];ContentLanguage=[% CurrentContentLanguage %]">[% Item.name %]</a></td>
                                    <td>[% Item.value_preview %]</td>
                                    <td>[% Item.active_label %]</td>
                                    <td>[% Item.sort_order %]</td>
                                    <td>
                                        <form class="qisutu-inline-form" method="post" action="[% FormAction %]">
                                            <input type="hidden" name="Page" value="[% PageName %]">
                                            <input type="hidden" name="Step" value="[% DeactivateStep %]">
                                            <input type="hidden" name="ItemID" value="[% Item.id %]">
                                            <input type="hidden" name="ContentLanguage" value="[% CurrentContentLanguage %]">
                                            <button class="qisutu-button qisutu-button-danger qisutu-button-small" type="submit">[% Translate.AdminDeactivate %]</button>
                                        </form>
                                    </td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>
                    </div>
                </section>
                [% END %]

                [% IF ShowCreate %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <h2>[% CreateTitle %]</h2>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=[% PageName %];ContentLanguage=[% CurrentContentLanguage %]">[% Translate.AdminBackToList %]</a>
                    </div>

                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="[% PageName %]">
                        <input type="hidden" name="Step" value="[% CreateStep %]">
                        <input type="hidden" name="ContentLanguage" value="[% CurrentContentLanguage %]">

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminName %]</label>
                                <input type="text" name="Name" required>
                            </div>
                            [% RAW.CreateValueFieldHTML %]
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminSortOrder %]</label>
                                <input type="number" name="SortOrder" value="1000" min="1">
                            </div>
                        </div>

                        <section class="qisutu-notification-placeholder-box">
                            <h3>[% Translate.AdminContentTemplatePlaceholders %]</h3>
                            <p>[% Translate.AdminContentTemplatePlaceholdersHint %]</p>
                            <div class="qisutu-notification-placeholder-grid">
                                [% FOREACH Placeholder IN PlaceholderList %]
                                <div class="qisutu-notification-placeholder-item">
                                    <code>[% Placeholder.placeholder %]</code>
                                    <span>[% Placeholder.description %]</span>
                                </div>
                                [% END %]
                            </div>
                        </section>

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminCreate %]</button>
                        </div>
                    </form>
                </section>
                [% END %]

                [% IF ShowEdit %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% EditTitle %]</h2>
                            <span class="qisutu-panel-subtitle">[% ItemName %]</span>
                        </div>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=[% PageName %];ContentLanguage=[% CurrentContentLanguage %]">[% Translate.AdminBackToList %]</a>
                    </div>

                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="[% PageName %]">
                        <input type="hidden" name="Step" value="[% UpdateStep %]">
                        <input type="hidden" name="ItemID" value="[% ItemID %]">
                        <input type="hidden" name="ContentLanguage" value="[% CurrentContentLanguage %]">

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminName %]</label>
                                <input type="text" name="Name" value="[% ItemName %]" required>
                            </div>
                            [% RAW.EditValueFieldHTML %]
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminSortOrder %]</label>
                                <input type="number" name="SortOrder" value="[% ItemSortOrder %]" min="1">
                            </div>
                            <label class="qisutu-form-checkbox qisutu-admin-active-checkbox">
                                <input type="checkbox" name="Active" value="1" [% ItemActiveChecked %]>
                                <span>[% Translate.AdminActive %]</span>
                            </label>
                        </div>

                        <section class="qisutu-notification-placeholder-box">
                            <h3>[% Translate.AdminContentTemplatePlaceholders %]</h3>
                            <p>[% Translate.AdminContentTemplatePlaceholdersHint %]</p>
                            <div class="qisutu-notification-placeholder-grid">
                                [% FOREACH Placeholder IN PlaceholderList %]
                                <div class="qisutu-notification-placeholder-item">
                                    <code>[% Placeholder.placeholder %]</code>
                                    <span>[% Placeholder.description %]</span>
                                </div>
                                [% END %]
                            </div>
                        </section>

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>
                        </div>
                    </form>
                </section>
                [% END %]
            </section>
            <script>
                window.QISUTU_STATIC_BASE = '[% StaticBase %]';
            </script>
            <script src="[% StaticBase %]/js/ckeditor5/ckeditor5.umd.js"></script>
            <script src="[% StaticBase %]/js/qisutu-richtext.js"></script>
            <script src="[% StaticBase %]/js/qisutu-localized-content.js?v=[% SystemVersion %]"></script>
