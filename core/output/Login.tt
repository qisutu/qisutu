        <section class="qisutu-login" aria-labelledby="qisutu-login-title">
            <div class="qisutu-login-panel">
                <div class="qisutu-login-brand">
                    <div class="qisutu-login-logo">
                        <img src="[% StaticBase %]/img/logo.png" style="height: 100%;" alt="Qisutu">
                    </div>
                    <div>
                        <h1 id="qisutu-login-title">[% SystemName %]</h1>
                        <p>[% Translate.LoginIntro %]</p>
                    </div>
                </div>

                <form class="qisutu-login-language" method="get" action="[% FormAction %]">
                    <input type="hidden" name="Step" value="LocalLogin">
                    <div class="qisutu-login-language-control">
                        <select id="qisutu-login-language" name="Language" aria-label="[% Translate.PreferencesLanguage %]" onchange="this.form.submit()">
                            [% FOREACH LoginLanguage IN LoginLanguages %]
                            <option value="[% LoginLanguage.code %]"[% RAW.LoginLanguage.selected %]>[% LoginLanguage.label %]</option>
                            [% END %]
                        </select>
                        <span class="qisutu-login-language-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M3 12h18M12 3c2.4 2.5 3.7 5.5 3.7 9S14.4 18.5 12 21M12 3C9.6 5.5 8.3 8.5 8.3 12s1.3 6.5 3.7 9"></path>
                            </svg>
                        </span>
                    </div>
                </form>

                [% IF ErrorMessage %]
                <div class="qisutu-login-message" role="alert">
                    [% ErrorMessage %]
                </div>
                [% END %]

                <form class="qisutu-login-form" method="post" action="[% FormAction %]" autocomplete="on">
                    <input type="hidden" name="Step" value="Login">
                    <input type="hidden" name="Language" value="[% Language %]">

                    <fieldset class="qisutu-login-type">
                        <legend>[% Translate.LoginAccountType %]</legend>
                        [% IF ShowLocalAgentLogin %]
                        <label>
                            <input type="radio" name="AccountType" value="agent" [% AgentChecked %]>
                            <span>[% Translate.LoginAsAgent %]</span>
                        </label>
                        [% END %]
                        <label>
                            <input type="radio" name="AccountType" value="customer" [% CustomerChecked %]>
                            <span>[% Translate.LoginAsCustomer %]</span>
                        </label>
                    </fieldset>

                    <div class="qisutu-login-field">
                        <label for="qisutu-login-name">[% Translate.LoginUsername %]</label>
                        <input
                            id="qisutu-login-name"
                            type="text"
                            name="Login"
                            value="[% LoginValue %]"
                            autocomplete="username"
                            required
                            autofocus>
                    </div>

                    <div class="qisutu-login-field">
                        <label for="qisutu-login-password">[% Translate.LoginPassword %]</label>
                        <input
                            id="qisutu-login-password"
                            type="password"
                            name="Password"
                            autocomplete="current-password"
                            required>
                    </div>

                    <button class="qisutu-login-button" type="submit">
                        [% Translate.LoginSubmit %]
                    </button>

                    [% IF HasExternalAuth %]
                    <div class="qisutu-login-external" aria-label="[% Translate.ExternalAuthOptions %]">
                        <span class="qisutu-login-external-separator">[% Translate.ExternalAuthOr %]</span>
                        [% FOREACH Provider IN ExternalAuthProviders %]
                        <a class="qisutu-login-button qisutu-login-button-external" href="[% Provider.begin_url %]">[% Provider.label %]</a>
                        [% END %]
                    </div>
                    [% END %]

                    <div class="qisutu-login-links qisutu-login-links-stack">
                        <a class="qisutu-login-link" href="[% PasswordForgotURL %]">[% Translate.PasswordForgotLink %]</a>
                        <a class="qisutu-login-link" href="[% CustomerRegistrationURL %]">[% Translate.CustomerRegistrationLink %]</a>
                    </div>
                </form>
            </div>
        </section>
