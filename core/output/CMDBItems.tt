%]

<section class="qisutu-dashboard qisutu-cmdb" aria-labelledby="qisutu-cmdb-title">
    <div class="qisutu-dashboard-header">
        <div><h1 id="qisutu-cmdb-title">[% ProgramTitle %]</h1><p>[% ProgramDescription %]</p></div>
        <div class="qisutu-form-actions">
            [% IF ShowListCanImport %]<a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=[% ProgramPage %];Action=ExportCSV">[% Translate.CMDBExportCSV %]</a><a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminCMDBImports">[% Translate.CMDBImportProfiles %]</a>[% END %]
            [% IF ShowListCanCreate %]<a class="qisutu-button qisutu-button-primary" href="index.pl?Page=[% ProgramPage %];Action=Create">[% Translate.CMDBCreate %]</a>[% END %]
            [% IF ShowBack %][% IF AdminMode %]<a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=[% ProgramPage %]">[% Translate.AdminBackToList %]</a>[% ELSE %]<button class="qisutu-button qisutu-button-secondary" type="button" onclick="history.back()">[% Translate.AdminBackToList %]</button>[% END %][% END %]
        </div>
    </div>
    <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>
    <div class="[% NoticeClass %]">[% NoticeMessage %]</div>

    [% IF AccessDenied %]<section class="qisutu-panel"><div class="qisutu-empty"><strong>[% Translate.CMDBAccessDenied %]</strong></div></section>[% END %]

    [% IF ShowList %]
    <section class="qisutu-panel">
        <form class="qisutu-cmdb-filter" method="get" action="index.pl"><input type="hidden" name="Page" value="[% ProgramPage %]"><div class="qisutu-form-field"><label>[% Translate.SearchTitle %]</label><input type="search" name="Search" value="[% Search %]" placeholder="[% Translate.CMDBSearchPlaceholder %]"></div><div class="qisutu-form-field"><label>[% Translate.CMDBType %]</label><select name="FilterTypeID">[% RAW.FilterTypeOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBStatus %]</label><select name="FilterStatus">[% RAW.FilterStatusOptionsHTML %]</select></div><label class="qisutu-form-checkbox"><input type="checkbox" name="IncludeInactive" value="1" [% IncludeInactiveChecked %]><span>[% Translate.CMDBIncludeArchived %]</span></label><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.SearchSubmit %]</button><a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=[% ProgramPage %]">[% Translate.SearchReset %]</a></form>
    </section>
    <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBConfigurationItems %]</h2><span class="qisutu-panel-subtitle">[% ItemCount %] [% Translate.AdminEntries %]</span></div></div>
        [% IF ItemCount %]<div class="qisutu-table-wrap"><table class="qisutu-table"><thead><tr><th>[% Translate.CMDBNumber %]</th><th>[% Translate.AdminName %]</th><th>[% Translate.CMDBType %]</th><th>[% Translate.CMDBStatus %]</th><th>[% Translate.TicketCustomer %]</th><th>[% Translate.CMDBTickets %]</th><th>[% Translate.AdminActive %]</th></tr></thead><tbody>[% FOREACH Item IN Items %]<tr><td><a class="qisutu-table-link" href="index.pl?Page=[% ProgramPage %];Action=View;CIID=[% Item.id %]">[% Item.ci_number %]</a></td><td><strong>[% Item.name %]</strong></td><td><span class="qisutu-cmdb-type-badge">[% Item.type_icon %] [% Item.type_name %]</span></td><td>[% Item.status_label %]</td><td>[% Item.customer_display %]</td><td>[% Item.ticket_count %]</td><td>[% Item.active_label %]</td></tr>[% END %]</tbody></table></div>[% ELSE %]<div class="qisutu-empty"><strong>[% Translate.CMDBEmptyTitle %]</strong><p>[% Translate.CMDBEmptyText %]</p></div>[% END %]
    </section>
    [% END %]

    [% IF ShowTypeSelection %]
    <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBSelectType %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBSelectTypeHelp %]</span></div></div><div class="qisutu-ticket-form-card-grid">[% FOREACH Type IN Types %]<article class="qisutu-ticket-form-card"><div class="qisutu-cmdb-type-card-icon">[% Type.icon %]</div><div><h3>[% Type.name %]</h3><p>[% Type.description %]</p></div><a class="qisutu-button qisutu-button-primary" href="index.pl?Page=[% ProgramPage %];Action=Create;TypeID=[% Type.id %]">[% Translate.CMDBSelect %]</a></article>[% END %]</div></section>
    [% END %]

    [% IF ShowForm %]
    <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% IF ShowCreate %][% Translate.CMDBCreate %][% ELSE %][% Translate.CMDBEdit %] [% CINumber %][% END %]</h2><span class="qisutu-panel-subtitle">[% CITypeIcon %] [% CITypeName %]</span></div></div>
        <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]" data-qisutu-cmdb-ci-form><input type="hidden" name="Page" value="[% ProgramPage %]"><input type="hidden" name="Step" value="CISave"><input type="hidden" name="CIID" value="[% CIID %]"><input type="hidden" name="TypeID" value="[% SelectedTypeID %]"><input type="hidden" name="CustomerID" value="[% CustomerID %]" data-qisutu-cmdb-customer-id>
            <div class="qisutu-admin-form-columns"><div class="qisutu-form-field"><label>[% Translate.AdminName %] *</label><input type="text" name="Name" value="[% CIName %]" maxlength="500" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBStatus %]</label><select name="Status">[% RAW.StatusOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBExternalID %]</label><input type="text" name="ExternalID" value="[% CIExternalID %]"></div></div>
            <fieldset class="qisutu-cmdb-assignment"><legend>[% Translate.CMDBAssignment %]</legend><div class="qisutu-cmdb-customer-selection" data-qisutu-cmdb-customer-selection><div data-qisutu-cmdb-customer-current>[% IF CustomerID %]<strong>[% CustomerName %]</strong><button class="qisutu-button-link" type="button" data-qisutu-cmdb-customer-clear>[% Translate.AdminRemove %]</button>[% ELSE %]<span class="qisutu-form-hint">[% Translate.CMDBNoCustomer %]</span>[% END %]</div><button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-cmdb-customer-open>[% Translate.CMDBSelectCustomer %]</button></div><div class="qisutu-form-field"><label>[% Translate.TicketCustomerUser %]</label><select name="CustomerUserID" data-qisutu-cmdb-customer-user data-options-url="index.pl?Page=[% ProgramPage %]&amp;Step=CustomerUsers">[% RAW.CustomerUserOptionsHTML %]</select></div></fieldset>
            <fieldset><legend>[% Translate.CMDBTypeFields %]</legend><div class="qisutu-admin-form-columns">[% RAW.CIFieldsHTML %]</div></fieldset>
            <div class="qisutu-cmdb-checkbox-row"><label class="qisutu-form-checkbox"><input type="checkbox" name="CustomerVisible" value="1" [% CICustomerVisibleChecked %]><span>[% Translate.CMDBCustomerVisible %]</span></label><label class="qisutu-form-checkbox"><input type="checkbox" name="Active" value="1" [% CIActiveChecked %]><span>[% Translate.AdminActive %]</span></label></div><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button><a class="qisutu-button qisutu-button-secondary" href="[% IF CIID %]index.pl?Page=[% ProgramPage %];Action=View;CIID=[% CIID %][% ELSE %]index.pl?Page=[% ProgramPage %][% END %]">[% Translate.AdminCancel %]</a></div>
        </form>
    </section>
    [% END %]

    [% IF ShowView %]
    <section class="qisutu-cmdb-detail-grid">
        <div>
            <section class="qisutu-panel qisutu-cmdb-hero"><div class="qisutu-panel-header"><div><span class="qisutu-cmdb-number">[% CINumber %]</span><h2>[% CIName %]</h2><span class="qisutu-cmdb-type-badge">[% CITypeIcon %] [% CITypeName %]</span></div><div class="qisutu-form-actions">[% IF CanChange %]<a class="qisutu-button qisutu-button-primary" href="index.pl?Page=[% ProgramPage %];Action=Edit;CIID=[% CIID %]">[% Translate.AdminEdit %]</a><form class="qisutu-inline-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="[% ProgramPage %]"><input type="hidden" name="Step" value="CIToggle"><input type="hidden" name="CIID" value="[% CIID %]"><input type="hidden" name="Active" value="[% IF CIActiveChecked %]0[% ELSE %]1[% END %]"><button class="qisutu-button qisutu-button-secondary" type="submit">[% IF CIActiveChecked %][% Translate.CMDBArchive %][% ELSE %][% Translate.CMDBActivate %][% END %]</button></form>[% END %]</div></div><dl class="qisutu-cmdb-core-data"><div><dt>[% Translate.CMDBStatus %]</dt><dd>[% CIStatusDisplay %]</dd></div><div><dt>[% Translate.TicketCustomer %]</dt><dd>[% CustomerName %]</dd></div><div><dt>[% Translate.CMDBSource %]</dt><dd>[% CISource %]</dd></div><div><dt>[% Translate.CMDBExternalID %]</dt><dd>[% CIExternalID %]</dd></div></dl><dl class="qisutu-ticket-info-list">[% RAW.CIDisplayHTML %]</dl></section>

            [% IF AdminMode %]<section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBTickets %]</h2><span class="qisutu-panel-subtitle">[% TicketCount %]</span></div></div>[% IF HasTickets %]<div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.TicketNumber %]</th><th>[% Translate.TicketTitle %]</th><th>[% Translate.TicketState %]</th><th>[% Translate.CMDBLinkedAt %]</th></tr></thead><tbody>[% FOREACH Ticket IN Tickets %]<tr><td><a class="qisutu-table-link" href="index.pl?Page=AgentTicketZoom;TicketID=[% Ticket.id %]">[% Ticket.ticket_number %]</a></td><td>[% Ticket.title %]</td><td>[% Ticket.state_name %]</td><td>[% Ticket.created_at %]</td></tr>[% END %]</tbody></table></div>[% ELSE %]<div class="qisutu-empty"><p>[% Translate.CMDBNoTickets %]</p></div>[% END %]</section>[% END %]

            [% IF AdminMode %]<section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBServices %]</h2><span class="qisutu-panel-subtitle">[% ServiceCount %]</span><p>[% Translate.CMDBServicesHint %]</p></div></div>[% IF HasServices %]<div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.AdminService %]</th><th>[% Translate.AdminDescription %]</th><th>[% Translate.AdminActive %]</th><th>[% Translate.CMDBLinkedAt %]</th></tr></thead><tbody>[% FOREACH Service IN Services %]<tr><td>[% RAW.Service.display_html %]</td><td>[% Service.description %]</td><td>[% Service.active_label %]</td><td>[% Service.created_at %]</td></tr>[% END %]</tbody></table></div>[% ELSE %]<div class="qisutu-empty"><p>[% Translate.CMDBNoServices %]</p></div>[% END %]</section>[% END %]

            [% IF AdminMode %]<section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBHistory %]</h2><span class="qisutu-panel-subtitle">[% HistoryCount %]</span></div></div>[% IF HasHistory %]<div class="qisutu-cmdb-history">[% FOREACH HistoryItem IN History %]<article><span class="qisutu-cmdb-history-marker"></span><div><header><strong>[% HistoryItem.event_label %]</strong><time>[% HistoryItem.created_at %]</time></header><p>[% HistoryItem.field_label %] [% HistoryItem.change_display %]</p><small>[% HistoryItem.actor_display %] · [% HistoryItem.source %]</small>[% RAW.HistoryItem.ticket_link_html %]</div></article>[% END %]</div>[% ELSE %]<div class="qisutu-empty"><p>[% Translate.CMDBHistoryEmpty %]</p></div>[% END %]</section>[% END %]
        </div>
        <aside>
            <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBRelations %]</h2><span class="qisutu-panel-subtitle">[% RelationCount %]</span></div></div>[% IF HasRelations %]<div class="qisutu-cmdb-relation-list">[% FOREACH Relation IN Relations %]<article><span>[% Relation.relation_label %]</span>[% RAW.Relation.related_display_html %]<small>[% Relation.note %]</small>[% RAW.Relation.remove_html %]</article>[% END %]</div>[% END %]
                [% IF CanChange %]<form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="[% ProgramPage %]"><input type="hidden" name="Step" value="RelationAdd"><input type="hidden" name="CIID" value="[% CIID %]"><div class="qisutu-form-field"><label>[% Translate.CMDBRelationType %]</label><select name="RelationTypeID">[% RAW.RelationTypeOptionsHTML %]</select></div><div class="qisutu-form-field qisutu-autocomplete"><label>[% Translate.CMDBTargetCI %]</label><input id="qisutu-cmdb-relation-target-id" type="hidden" name="TargetCIID" data-qisutu-autocomplete-target><input type="text" name="TargetCINumber" autocomplete="off" required data-qisutu-cmdb-autocomplete data-qisutu-autocomplete-url="index.pl?Page=[% ProgramPage %]&amp;Step=Search" data-qisutu-autocomplete-hidden="qisutu-cmdb-relation-target-id"><div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div></div><div class="qisutu-form-field"><label>[% Translate.CMDBRelationNote %]</label><input type="text" name="RelationNote"></div><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.CMDBRelationAdd %]</button></form>[% END %]
            </section>
        </aside>
    </section>
    [% END %]

    [% IF ShowImport %]
    <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBImportExport %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBImportHelp %]</span></div><a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=[% ProgramPage %];Action=ExportCSV">[% Translate.CMDBExportCSV %]</a></div><form class="qisutu-admin-form" method="post" action="[% FormAction %]" enctype="multipart/form-data"><input type="hidden" name="Page" value="[% ProgramPage %]"><input type="hidden" name="Step" value="CSVImport"><input type="hidden" name="Action" value="Import"><div class="qisutu-form-field"><label>[% Translate.CMDBCSVFile %]</label><input type="file" name="CMDBCSV" accept=".csv,text/csv" required><span class="qisutu-form-hint">[% Translate.CMDBCSVLimit %]</span></div><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.CMDBImportCSV %]</button></form></section>
    [% END %]
</section>

<div class="qisutu-overlay" data-qisutu-cmdb-customer-overlay hidden><div class="qisutu-overlay-dialog qisutu-cmdb-customer-dialog" role="dialog" aria-modal="true"><div class="qisutu-overlay-header"><div><h2>[% Translate.CMDBSelectCustomer %]</h2><p>[% Translate.CMDBCustomerSearchHelp %]</p></div><button class="qisutu-overlay-close" type="button" data-qisutu-cmdb-customer-close aria-label="[% Translate.AdminClose %]">×</button></div><div class="qisutu-form-field"><label>[% Translate.SearchTitle %]</label><input type="search" data-qisutu-cmdb-customer-search data-url="index.pl?Page=[% ProgramPage %]&amp;Step=CustomerSearch" autocomplete="off"></div><div class="qisutu-cmdb-customer-results" data-qisutu-cmdb-customer-results></div></div></div>

<script src="[% StaticBase %]/js/qisutu-cmdb.js?v=2026071801"></script>
