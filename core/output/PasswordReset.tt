        <section class="qisutu-login" aria-labelledby="qisutu-password-reset-title">
            <div class="qisutu-login-panel">
                <div class="qisutu-login-brand">
                    <div class="qisutu-login-logo">
                        <img src="[% StaticBase %]/img/logo.png" style="height: 100%;" alt="Qisutu">
                    </div>
                    <div>
                        <h1 id="qisutu-password-reset-title">[% Translate.PasswordResetTitle %]</h1>
                        <p>[% Translate.PasswordResetIntro %]</p>
                    </div>
                </div>

                <div class="qisutu-login-message" role="alert">
                    [% ErrorMessage %]
                </div>

                <form class="qisutu-login-form" method="post" action="[% FormAction %]" autocomplete="off">
                    <input type="hidden" name="Step" value="PasswordResetSubmit">
                    <input type="hidden" name="Token" value="[% Token %]">

                    <div class="qisutu-login-field">
                        <label for="qisutu-password-reset-new">[% Translate.PasswordResetNewPassword %]</label>
                        <input
                            id="qisutu-password-reset-new"
                            type="password"
                            name="NewPassword"
                            autocomplete="new-password"
                            minlength="8"
                            maxlength="4096"
                            required
                            autofocus>
                    </div>

                    <div class="qisutu-login-field">
                        <label for="qisutu-password-reset-repeat">[% Translate.PasswordResetRepeatPassword %]</label>
                        <input
                            id="qisutu-password-reset-repeat"
                            type="password"
                            name="RepeatPassword"
                            autocomplete="new-password"
                            minlength="8"
                            maxlength="4096"
                            required>
                    </div>

                    <p class="qisutu-login-hint">[% Translate.PasswordResetPasswordHint %]</p>

                    <button class="qisutu-login-button" type="submit">
                        [% Translate.PasswordResetSubmit %]
                    </button>

                    <div class="qisutu-login-links">
                        <a class="qisutu-login-link" href="index.pl">[% Translate.PasswordBackToLogin %]</a>
                    </div>
                </form>
            </div>
        </section>
