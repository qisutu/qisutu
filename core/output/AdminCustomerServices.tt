<section class="qisutu-dashboard" aria-labelledby="qisutu-admin-customer-services-title">
    <div class="qisutu-dashboard-header"><div><h1 id="qisutu-admin-customer-services-title">[% ProgramTitle %]</h1><p>[% ProgramDescription %]</p></div></div>
    <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>
    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><h2>[% Translate.AdminCustomerServiceCustomerSelect %]</h2></div>
        <form method="get" action="index.pl" class="qisutu-admin-form"><input type="hidden" name="Page" value="AdminCustomerServices"><div class="qisutu-form-field"><label>[% Translate.AdminCustomer %]</label><select name="CustomerID" required onchange="this.form.submit()"><option value="">[% Translate.AdminNoSelection %]</option>[% RAW.CustomerOptionsHTML %]</select></div></form>
    </section>

    [% IF HasCustomer %]
    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.AdminCustomerServicesFor %] [% CustomerName %]</h2><span class="qisutu-panel-subtitle">[% Translate.AdminCustomerServicesHint %]</span></div></div>
        <form method="post" action="[% FormAction %]">
            <input type="hidden" name="Page" value="AdminCustomerServices"><input type="hidden" name="Step" value="CustomerServiceSave"><input type="hidden" name="CustomerID" value="[% CustomerID %]">
            <div class="qisutu-admin-table-wrap"><table class="qisutu-admin-table">
                <thead><tr><th>[% Translate.AdminAssigned %]</th><th>[% Translate.AdminService %]</th><th>[% Translate.AdminSLA %]</th><th>[% Translate.AdminActive %]</th></tr></thead>
                <tbody>
                [% FOREACH Assignment IN AssignmentList %]
                    <tr>
                        <td><input type="checkbox" name="ServiceActive_[% Assignment.service_id %]" value="1" [% Assignment.active_checked %] [% Assignment.assignment_disabled %]></td>
                        <td><strong>[% Assignment.service_name %]</strong></td>
                        <td><select name="SLAID_[% Assignment.service_id %]" [% Assignment.assignment_disabled %]><option value="">[% Translate.AdminNoSelection %]</option>[% RAW.Assignment.sla_options_html %]</select></td>
                        <td>[% Assignment.service_active_label %]</td>
                    </tr>
                [% END %]
                </tbody>
            </table></div>
            <div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button></div>
        </form>
    </section>
    [% END %]
</section>
