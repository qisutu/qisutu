            <section class="qisutu-dashboard" aria-labelledby="qisutu-customer-auto-responses-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-customer-auto-responses-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                </div>

                <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>

                <form class="qisutu-localized-content-language" method="get" action="[% FormAction %]" data-localized-content-language-form>
                    <input type="hidden" name="Page" value="AdminCustomerAutoResponses">
                    [% IF ShowEdit %]
                    <input type="hidden" name="Action" value="Edit">
                    <input type="hidden" name="ResponseType" value="[% CurrentType %]">
                    [% END %]
                    <div class="qisutu-form-field">
                        <label for="qisutu-customer-auto-response-language">[% Translate.AdminTranslationLanguage %]</label>
                        <select id="qisutu-customer-auto-response-language" name="ResponseLanguage" data-localized-content-language>
                            [% RAW.LanguageOptionsHTML %]
                        </select>
                    </div>
                    <button class="qisutu-button qisutu-button-secondary" type="submit">[% Translate.AdminFilterApply %]</button>
                </form>

                [% IF ShowList %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminCustomerAutoResponsesList %]</h2>
                            <span class="qisutu-panel-subtitle">[% TemplateCount %] [% Translate.AdminEntries %]</span>
                        </div>
                    </div>

                    <div class="qisutu-table-wrap">
                        <table class="qisutu-table qisutu-table-compact">
                            <thead>
                                <tr>
                                    <th>[% Translate.AdminCustomerAutoResponseAction %]</th>
                                    <th>[% Translate.AdminSubject %]</th>
                                    <th>[% Translate.AdminActive %]</th>
                                    <th>[% Translate.AdminAction %]</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH Template IN TemplateList %]
                                <tr>
                                    <td><a class="qisutu-table-link" href="index.pl?Page=AdminCustomerAutoResponses;Action=Edit;ResponseType=[% Template.response_type %];ResponseLanguage=[% CurrentLanguage %]">[% Template.display_name %]</a></td>
                                    <td>[% Template.subject %]</td>
                                    <td>[% Template.active_label %]</td>
                                    <td><a class="qisutu-button qisutu-button-secondary qisutu-button-small" href="index.pl?Page=AdminCustomerAutoResponses;Action=Edit;ResponseType=[% Template.response_type %];ResponseLanguage=[% CurrentLanguage %]">[% Translate.AdminEdit %]</a></td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>
                    </div>
                </section>
                [% END %]

                [% IF ShowEdit %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminCustomerAutoResponseEdit %]</h2>
                            <span class="qisutu-panel-subtitle">[% CurrentName %]</span>
                        </div>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminCustomerAutoResponses;ResponseLanguage=[% CurrentLanguage %]">[% Translate.AdminBackToList %]</a>
                    </div>

                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="AdminCustomerAutoResponses">
                        <input type="hidden" name="Step" value="AutoResponseUpdate">
                        <input type="hidden" name="Action" value="Edit">
                        <input type="hidden" name="ResponseType" value="[% CurrentType %]">
                        <input type="hidden" name="ResponseLanguage" value="[% CurrentLanguage %]">

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminCustomerAutoResponseAction %]</label>
                                <input type="text" value="[% CurrentName %]" readonly>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminSubject %]</label>
                                <input type="text" name="Subject" value="[% CurrentSubject %]" required>
                            </div>
                            <label class="qisutu-form-checkbox qisutu-admin-active-checkbox">
                                <input type="checkbox" name="Active" value="1" [% CurrentActiveChecked %]>
                                <span>[% Translate.AdminActive %]</span>
                            </label>
                        </div>

                        <div class="qisutu-form-field qisutu-form-field-richtext">
                            <label>[% Translate.AdminCustomerAutoResponseText %]</label>
                            <textarea class="qisutu-richtext" name="BodyHTML" rows="12">[% CurrentBodyHTML %]</textarea>
                        </div>

                        <section class="qisutu-notification-placeholder-box">
                            <h3>[% Translate.AdminCustomerAutoResponsePlaceholders %]</h3>
                            <p>[% Translate.AdminCustomerAutoResponsePlaceholdersHint %]</p>
                            <div class="qisutu-notification-placeholder-grid">
                                [% FOREACH Placeholder IN PlaceholderList %]
                                <div class="qisutu-notification-placeholder-item">
                                    <code>[% Placeholder.placeholder %]</code>
                                    <span>[% Placeholder.description %]</span>
                                </div>
                                [% END %]
                            </div>
                        </section>

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>
                        </div>
                    </form>
                </section>
                [% END %]
            </section>
            <script>
                window.QISUTU_STATIC_BASE = '[% StaticBase %]';
            </script>
            <script src="[% StaticBase %]/js/ckeditor5/ckeditor5.umd.js"></script>
            <script src="[% StaticBase %]/js/qisutu-richtext.js"></script>
            <script src="[% StaticBase %]/js/qisutu-localized-content.js?v=[% SystemVersion %]"></script>
