            <section class="qisutu-dashboard" aria-labelledby="qisutu-customer-ticket-create-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-customer-ticket-create-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                    <a class="qisutu-button qisutu-button-secondary" href="[% TicketListURL %]">[% Translate.TicketBackToList %]</a>
                </div>

                <section class="qisutu-panel">
                    <div class="qisutu-form-error [% CreateErrorClass %]">[% CreateError %]</div>

                    [% IF ShowFormSelection %]
                    <div class="qisutu-ticket-form-intro">
                        <h2>[% Translate.TicketFormsSelectTitle %]</h2>
                        <p>[% Translate.TicketFormsSelectDescription %]</p>
                    </div>
                    [% IF ShowStandardTicketCard %]
                    <div class="qisutu-ticket-form-card-grid qisutu-standard-ticket-card-grid">
                        <article class="qisutu-ticket-form-card">
                            <div>
                                <h3>[% Translate.CustomerStandardTicketTitle %]</h3>
                                <p>[% Translate.CustomerStandardTicketDescription %]</p>
                            </div>
                            <a class="qisutu-button qisutu-button-primary" href="[% StandardTicketURL %]">[% Translate.CustomerStandardTicketOpen %]</a>
                        </article>
                    </div>
                    [% END %]
                    <div class="qisutu-ticket-form-card-grid">
                        [% FOREACH TicketForm IN TicketForms %]
                        <article class="qisutu-ticket-form-card">
                            <div>
                                <h3>[% TicketForm.title %]</h3>
                                <p>[% TicketForm.description %]</p>
                                <span class="qisutu-form-hint">[% Translate.TicketQueue %]: [% TicketForm.queue_display %]</span>
                            </div>
                            <a class="qisutu-button qisutu-button-primary" href="[% TicketForm.open_url %]">[% Translate.TicketFormOpen %]</a>
                        </article>
                        [% END %]
                    </div>
                    [% END %]

                    [% IF ShowConfiguredForm %]
                    <div class="qisutu-ticket-form-intro">
                        <h2>[% TicketFormTitle %]</h2>
                        <p>[% TicketFormDescription %]</p>
                    </div>
                    <form class="qisutu-admin-form qisutu-admin-form-wide qisutu-ticket-form" method="post" action="[% FormAction %]" enctype="multipart/form-data">
                        <input type="hidden" name="Page" value="CustomerTicketCreate">
                        <input type="hidden" name="Step" value="CustomerTicketFormSubmit">
                        <input type="hidden" name="FormID" value="[% FormID %]">
                        [% RAW.TicketFormFieldsHTML %]
                        <div class="qisutu-form-field qisutu-ticket-reply-attachments">
                            <label for="qisutu-customer-form-attachments">[% Translate.TicketArticleAttachments %]</label>
                            <input id="qisutu-customer-form-attachments" type="file" name="TicketAttachment" multiple data-qisutu-attachment-input data-qisutu-attachment-max-bytes="[% AttachmentMaxSizeBytes %]" data-qisutu-attachment-max-label="[% AttachmentMaxSizeMB %] MB">
                            <div class="qisutu-ticket-reply-attachment-list" data-qisutu-attachment-list data-qisutu-attachment-remove-label="[% Translate.TicketArticleAttachmentRemove %]">
                                <p class="qisutu-form-hint" data-qisutu-attachment-empty>[% Translate.TicketArticleAttachmentsEmpty %]</p>
                            </div>
                            <span class="qisutu-form-hint">[% Translate.TicketArticleAttachmentLimitHelp %] [% AttachmentMaxSizeMB %] MB</span>
                        </div>
                        [% RAW.CMDBSelectionHTML %]
                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% TicketFormSubmitLabel %]</button>
                            <a class="qisutu-button qisutu-button-secondary" href="[% FormSelectionURL %]">[% Translate.AdminBackToList %]</a>
                        </div>
                    </form>
                    [% END %]

                    [% IF ShowLegacyForm %]
                    [% IF HasQueueOptions %]
                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]" enctype="multipart/form-data">
                        <input type="hidden" name="Page" value="CustomerTicketCreate">
                        <input type="hidden" name="Step" value="CustomerTicketCreate">
                        <input type="hidden" name="StandardTicket" value="1">

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label>[% Translate.TicketArticleSubject %]</label>
                                <input type="text" name="Title" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.TicketQueue %]</label>
                                <select name="QueueID" required>
                                    [% RAW.QueueOptionsHTML %]
                                </select>
                            </div>
                        </div>

                        <div class="qisutu-form-field">
                            <label>[% Translate.TicketArticleBody %]</label>
                            <textarea id="qisutu-customer-ticket-body" class="qisutu-richtext" name="Body" rows="8"></textarea>
                        </div>

                        <div class="qisutu-form-field qisutu-ticket-reply-attachments">
                            <label for="qisutu-customer-ticket-attachments">[% Translate.TicketArticleAttachments %]</label>
                            <input id="qisutu-customer-ticket-attachments" type="file" name="TicketAttachment" multiple data-qisutu-attachment-input data-qisutu-attachment-max-bytes="[% AttachmentMaxSizeBytes %]" data-qisutu-attachment-max-label="[% AttachmentMaxSizeMB %] MB">
                            <div class="qisutu-ticket-reply-attachment-list" data-qisutu-attachment-list data-qisutu-attachment-remove-label="[% Translate.TicketArticleAttachmentRemove %]">
                                <p class="qisutu-form-hint" data-qisutu-attachment-empty>[% Translate.TicketArticleAttachmentsEmpty %]</p>
                            </div>
                            <span class="qisutu-form-hint">[% Translate.TicketArticleAttachmentLimitHelp %] [% AttachmentMaxSizeMB %] MB</span>
                        </div>

                        [% RAW.CMDBSelectionHTML %]

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketCreateSubmit %]</button>
                            [% IF ShowStandardBackToSelection %]
                            <a class="qisutu-button qisutu-button-secondary" href="[% FormSelectionURL %]">[% Translate.AdminBackToList %]</a>
                            [% END %]
                        </div>
                    </form>
                    [% END %]
                    [% END %]
                </section>
            </section>
            <div class="qisutu-attachment-limit-overlay" data-qisutu-attachment-limit-overlay hidden>
                <div class="qisutu-attachment-limit-dialog" role="alertdialog" aria-modal="true" aria-labelledby="qisutu-customer-ticket-attachment-limit-title">
                    <h3 id="qisutu-customer-ticket-attachment-limit-title">[% Translate.TicketArticleAttachmentTooLargeTitle %]</h3>
                    <p data-qisutu-attachment-limit-message data-qisutu-message-template="[% Translate.TicketArticleAttachmentTooLargeMessage %]"></p>
                    <p>[% Translate.TicketArticleAttachmentTooLargeAdmin %]</p>
                    <div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="button" data-qisutu-attachment-limit-close>[% Translate.TicketArticleAttachmentDialogOK %]</button></div>
                </div>
            </div>
            <script>
                window.QISUTU_STATIC_BASE = '[% StaticBase %]';
            </script>
            <script src="[% StaticBase %]/js/ckeditor5/ckeditor5.umd.js"></script>
            <script src="[% StaticBase %]/js/qisutu-richtext.js"></script>
            <script src="[% StaticBase %]/js/qisutu-customer-ticket-create.js?v=2026082801"></script>

[% IF ShowKnowledgeSuggestions %]
<link rel="stylesheet" href="[% StaticBase %]/css/qisutu-knowledge-suggestions.css?v=[% SystemVersion %]">
<section id="qisutu-knowledge-suggestions" class="qisutu-knowledge-suggestions qisutu-form-field-wide qisutu-ticket-form-field-wide" aria-labelledby="qisutu-knowledge-suggestions-heading" hidden
    data-field-name="[% KnowledgeFieldName %]"
    data-body-field-name="[% KnowledgeBodyFieldName %]"
    data-language="[% KnowledgeLanguage %]"
    data-endpoint="[% KnowledgeEndpoint %]"
    data-csrf-token="[% CSRFToken %]"
    data-minimum-length="[% KnowledgeMinimumLength %]"
    data-debounce="[% KnowledgeDebounce %]"
    data-message-loading="[% Translate.KnowledgeSuggestionsLoading %]"
    data-message-empty="[% Translate.KnowledgeSuggestionsEmpty %]"
    data-message-browse-empty="[% Translate.KnowledgeSuggestionsBrowseEmpty %]"
    data-message-error="[% Translate.KnowledgeSuggestionsError %]"
    data-message-open="[% Translate.KnowledgeSuggestionsOpen %]"
    data-message-article-loading="[% Translate.KnowledgeSuggestionsArticleLoading %]"
    data-message-article-error="[% Translate.KnowledgeSuggestionsArticleError %]"
    data-message-result-count="[% Translate.KnowledgeSuggestionsResultCount %]">
    <div class="qisutu-knowledge-suggestions-heading">
        <span class="qisutu-knowledge-suggestions-icon" aria-hidden="true">?</span>
        <div>
            <h2 id="qisutu-knowledge-suggestions-heading">[% Translate.KnowledgeSuggestionsHeading %]</h2>
            <p class="qisutu-knowledge-suggestions-hint">[% Translate.KnowledgeSuggestionsHint %]</p>
        </div>
        <button class="qisutu-button qisutu-button-secondary qisutu-knowledge-choose" type="button" data-knowledge-choose aria-controls="qisutu-knowledge-browser" aria-expanded="false">[% Translate.KnowledgeSuggestionsChoose %]</button>
    </div>
    <div id="qisutu-knowledge-browser" class="qisutu-knowledge-browser" data-knowledge-browser hidden>
        <h3>[% Translate.KnowledgeSuggestionsBrowseHeading %]</h3>
        <p class="qisutu-knowledge-suggestions-hint">[% Translate.KnowledgeSuggestionsBrowseHint %]</p>
        <label for="qisutu-knowledge-browse-query">[% Translate.KnowledgeSuggestionsBrowseQuery %]</label>
        <div class="qisutu-knowledge-browse-controls">
            <input id="qisutu-knowledge-browse-query" type="search" maxlength="500" data-knowledge-browse-query autocomplete="off">
            <button class="qisutu-button qisutu-button-secondary" type="button" data-knowledge-browse-search>[% Translate.KnowledgeSuggestionsBrowseSearch %]</button>
        </div>
        <p class="qisutu-knowledge-suggestions-status" data-knowledge-browse-status role="status" aria-live="polite" aria-atomic="true"></p>
        <ul class="qisutu-knowledge-suggestions-results qisutu-knowledge-browse-results" data-knowledge-browse-results></ul>
    </div>
    <div data-knowledge-automatic hidden>
        <p class="qisutu-knowledge-suggestions-status" data-knowledge-status role="status" aria-live="polite" aria-atomic="true"></p>
        <ul class="qisutu-knowledge-suggestions-results" data-knowledge-results></ul>
    </div>
</section>
<dialog id="qisutu-knowledge-dialog" class="qisutu-knowledge-dialog" aria-labelledby="qisutu-knowledge-dialog-title">
    <div class="qisutu-knowledge-dialog-shell">
        <div class="qisutu-knowledge-dialog-header">
            <h2 id="qisutu-knowledge-dialog-title" data-knowledge-dialog-title></h2>
            <button class="qisutu-knowledge-dialog-close" type="button" data-knowledge-dialog-close aria-label="[% Translate.KnowledgeSuggestionsClose %]" autofocus>×</button>
        </div>
        <div class="qisutu-knowledge-dialog-body">
            <p class="qisutu-knowledge-dialog-status" data-knowledge-dialog-status role="status" aria-live="polite" aria-atomic="true"></p>
            <p class="qisutu-knowledge-dialog-category" data-knowledge-dialog-category hidden></p>
            <p class="qisutu-knowledge-dialog-summary" data-knowledge-dialog-summary hidden></p>
            <div class="qisutu-knowledge-dialog-content" data-knowledge-dialog-content></div>
            <section class="qisutu-knowledge-dialog-attachments" data-knowledge-dialog-attachments hidden aria-labelledby="qisutu-knowledge-attachments-heading">
                <h3 id="qisutu-knowledge-attachments-heading">[% Translate.KnowledgeSuggestionsAttachments %]</h3>
                <ul data-knowledge-dialog-attachment-list></ul>
            </section>
        </div>
        <div class="qisutu-knowledge-dialog-actions">
            <a class="qisutu-button qisutu-button-secondary" data-knowledge-dialog-portal target="_blank" rel="noopener noreferrer" hidden>[% Translate.KnowledgeSuggestionsOpenPortal %]</a>
            <button class="qisutu-button qisutu-button-primary" type="button" data-knowledge-dialog-continue>[% Translate.KnowledgeSuggestionsContinue %]</button>
        </div>
    </div>
</dialog>
<script src="[% StaticBase %]/js/qisutu-knowledge-suggestions.js?v=[% SystemVersion %]" defer></script>
[% END %]
