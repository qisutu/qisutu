%]

<section class="qisutu-dashboard" aria-labelledby="qisutu-cmdb-types-title">
    <div class="qisutu-dashboard-header">
        <div><h1 id="qisutu-cmdb-types-title">[% ProgramTitle %]</h1><p>[% ProgramDescription %]</p></div>
        [% IF ShowList %]<a class="qisutu-button qisutu-button-primary" href="index.pl?Page=AdminCMDBTypes;Action=Create">[% Translate.CMDBTypeCreate %]</a>[% ELSE %]<a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminCMDBTypes">[% Translate.AdminBackToList %]</a>[% END %]
    </div>
    <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>
    <div class="[% NoticeClass %]">[% NoticeMessage %]</div>

    [% IF ShowList %]
    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.CMDBTypes %]</h2><span class="qisutu-panel-subtitle">[% TypeCount %] [% Translate.AdminEntries %]</span></div></div>
        <div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.AdminName %]</th><th>[% Translate.CMDBFields %]</th><th>[% Translate.CMDBItemsTitle %]</th><th>[% Translate.AdminActive %]</th><th>[% Translate.AdminAction %]</th></tr></thead><tbody>
        [% FOREACH Type IN Types %]<tr><td><a class="qisutu-table-link" href="index.pl?Page=AdminCMDBTypes;Action=Edit;TypeID=[% Type.id %]">[% Type.icon %] [% Type.name %]</a><small class="qisutu-table-secondary">[% Type.description %]</small></td><td>[% Type.field_count %]</td><td>[% Type.ci_count %]</td><td>[% Type.active_label %]</td><td><form class="qisutu-inline-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="TypeToggle"><input type="hidden" name="TypeID" value="[% Type.id %]"><input type="hidden" name="Active" value="[% Type.toggle_value %]"><button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="submit">[% Type.toggle_label %]</button></form></td></tr>[% END %]
        </tbody></table></div>
    </section>

    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.CMDBStatuses %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBStatusesHelp %]</span></div></div>
        [% IF HasStatuses %]<div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.CMDBTechnicalKey %]</th><th>[% Translate.AdminName %]</th><th>[% Translate.CMDBStatusClass %]</th><th>[% Translate.AdminActive %]</th><th>[% Translate.AdminAction %]</th></tr></thead><tbody>[% FOREACH Status IN Statuses %]<tr><td>[% Status.status_key %]</td><td><span style="color:[% Status.color %]">●</span> [% Status.label %]</td><td>[% Status.status_class %]</td><td>[% Status.active_label %]</td><td><form class="qisutu-inline-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="StatusToggle"><input type="hidden" name="StatusID" value="[% Status.id %]"><input type="hidden" name="Active" value="[% Status.toggle_value %]"><button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="submit">[% Status.toggle_label %]</button></form></td></tr>[% END %]</tbody></table></div>[% END %]
        <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="StatusSave"><div class="qisutu-admin-form-columns"><div class="qisutu-form-field"><label>[% Translate.CMDBTechnicalKey %] *</label><input type="text" name="StatusKey" required placeholder="in_betrieb"></div><div class="qisutu-form-field"><label>[% Translate.AdminName %] *</label><input type="text" name="StatusLabel" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBStatusClass %]</label><select name="StatusClass"><option value="active">active</option><option value="inactive">inactive</option><option value="retired">retired</option></select></div><div class="qisutu-form-field"><label>[% Translate.CMDBColor %]</label><input type="color" name="StatusColor" value="#4b6478"></div><div class="qisutu-form-field"><label>[% Translate.AdminSortOrder %]</label><input type="number" name="StatusSortOrder" value="1000" min="0"></div></div><label class="qisutu-form-checkbox"><input type="checkbox" name="StatusActive" value="1" checked><span>[% Translate.AdminActive %]</span></label><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminCreate %]</button></div></form>
    </section>

    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.CMDBRelationTypes %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBRelationTypesHelp %]</span></div></div>
        <div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.AdminName %]</th><th>[% Translate.CMDBForwardLabel %]</th><th>[% Translate.CMDBReverseLabel %]</th><th>[% Translate.AdminActive %]</th><th>[% Translate.AdminAction %]</th></tr></thead><tbody>[% FOREACH Relation IN RelationTypes %]<tr><td>[% Relation.name %]</td><td>[% Relation.forward_label %]</td><td>[% Relation.reverse_label %]</td><td>[% Relation.active_label %]</td><td><form class="qisutu-inline-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="RelationTypeToggle"><input type="hidden" name="RelationTypeID" value="[% Relation.id %]"><input type="hidden" name="Active" value="[% Relation.toggle_value %]"><button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="submit">[% Relation.toggle_label %]</button></form></td></tr>[% END %]</tbody></table></div>
        <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="RelationTypeSave"><div class="qisutu-admin-form-columns"><div class="qisutu-form-field"><label>[% Translate.AdminName %] *</label><input type="text" name="RelationName" required placeholder="managed_by"></div><div class="qisutu-form-field"><label>[% Translate.CMDBForwardLabel %] *</label><input type="text" name="ForwardLabel" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBReverseLabel %] *</label><input type="text" name="ReverseLabel" required></div><div class="qisutu-form-field"><label>[% Translate.AdminSortOrder %]</label><input type="number" name="RelationSortOrder" value="1000" min="0"></div></div><label class="qisutu-form-checkbox"><input type="checkbox" name="RelationActive" value="1" checked><span>[% Translate.AdminActive %]</span></label><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminCreate %]</button></div></form>
    </section>
    [% END %]

    [% IF ShowTypeForm %]
    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><h2>[% IF ShowCreate %][% Translate.CMDBTypeCreate %][% ELSE %][% Translate.CMDBTypeEdit %][% END %]</h2></div>
        <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="TypeSave"><input type="hidden" name="TypeID" value="[% TypeID %]"><div class="qisutu-admin-form-columns"><div class="qisutu-form-field"><label>[% Translate.CMDBTechnicalKey %] *</label><input type="text" name="TypeKey" value="[% TypeKey %]" [% TypeKeyReadonly %] required></div><div class="qisutu-form-field"><label>[% Translate.AdminName %] *</label><input type="text" name="Name" value="[% TypeName %]" maxlength="255" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBIcon %]</label><input type="text" name="Icon" value="[% TypeIcon %]" maxlength="20"></div><div class="qisutu-form-field"><label>[% Translate.AdminSortOrder %]</label><input type="number" name="SortOrder" value="[% TypeSortOrder %]" min="0"></div></div><div class="qisutu-form-field"><label>[% Translate.AdminDescription %]</label><textarea name="Description" rows="3">[% TypeDescription %]</textarea></div><label class="qisutu-form-checkbox"><input type="checkbox" name="Active" value="1" [% TypeActiveChecked %]><span>[% Translate.AdminActive %]</span></label><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button></div></form>
    </section>
    [% END %]

    [% IF ShowEdit %]
    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.CMDBTypeStatuses %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBTypeStatusesHelp %]</span></div></div>
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="TypeStatusSave"><input type="hidden" name="TypeID" value="[% TypeID %]"><div class="qisutu-cmdb-checkbox-row">[% FOREACH Status IN Statuses %]<label class="qisutu-form-checkbox"><input type="checkbox" name="StatusIDs" value="[% Status.id %]" [% Status.type_checked %]><span>[% Status.label %]</span></label>[% END %]</div><div class="qisutu-form-field"><label>[% Translate.CMDBDefaultStatus %]</label><select name="DefaultStatusID">[% RAW.DefaultStatusOptionsHTML %]</select></div><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button></div></form>
    </section>

    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.CMDBFieldGroups %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBFieldGroupsHelp %]</span></div></div>
        [% IF HasGroups %]<div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.CMDBTechnicalKey %]</th><th>[% Translate.AdminName %]</th><th>[% Translate.CMDBFields %]</th></tr></thead><tbody>[% FOREACH Group IN Groups %]<tr><td>[% Group.group_key %]</td><td>[% Group.label %]</td><td>[% Group.field_count %]</td></tr>[% END %]</tbody></table></div>[% END %]
        <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="FieldGroupSave"><input type="hidden" name="TypeID" value="[% TypeID %]"><div class="qisutu-admin-form-columns"><div class="qisutu-form-field"><label>[% Translate.CMDBTechnicalKey %] *</label><input type="text" name="GroupKey" required></div><div class="qisutu-form-field"><label>[% Translate.AdminName %] *</label><input type="text" name="GroupLabel" required></div><div class="qisutu-form-field"><label>[% Translate.AdminSortOrder %]</label><input type="number" name="GroupSortOrder" value="1000" min="0"></div></div><div class="qisutu-form-field"><label>[% Translate.AdminDescription %]</label><input type="text" name="GroupDescription"></div><label class="qisutu-form-checkbox"><input type="checkbox" name="GroupActive" value="1" checked><span>[% Translate.AdminActive %]</span></label><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminCreate %]</button></div></form>
    </section>

    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.CMDBFields %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBFieldsHelp %]</span></div></div>
        [% IF HasFields %]<div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.CMDBFieldKey %]</th><th>[% Translate.CMDBFieldGroup %]</th><th>[% Translate.CMDBFieldLabel %]</th><th>[% Translate.CMDBFieldType %]</th><th>[% Translate.CMDBRequired %]</th><th>[% Translate.CMDBSearchable %]</th><th>[% Translate.CMDBUnique %]</th><th>[% Translate.CMDBCustomerVisible %]</th><th>[% Translate.AdminActive %]</th><th>[% Translate.AdminAction %]</th></tr></thead><tbody>[% FOREACH Field IN Fields %]<tr><td><a class="qisutu-table-link" href="index.pl?Page=AdminCMDBTypes;Action=FieldEdit;TypeID=[% TypeID %];FieldID=[% Field.id %]">[% Field.field_key %]</a></td><td>[% Field.group_label %]</td><td>[% Field.label %]</td><td>[% Field.field_type %]</td><td>[% Field.required_label %]</td><td>[% Field.searchable_label %]</td><td>[% Field.unique_label %]</td><td>[% Field.customer_label %]</td><td>[% Field.active_label %]</td><td><form class="qisutu-inline-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="FieldToggle"><input type="hidden" name="TypeID" value="[% TypeID %]"><input type="hidden" name="FieldID" value="[% Field.id %]"><input type="hidden" name="Active" value="[% Field.toggle_value %]"><button class="qisutu-button qisutu-button-secondary qisutu-button-small" type="submit">[% Field.toggle_label %]</button></form></td></tr>[% END %]</tbody></table></div>[% END %]

        <form class="qisutu-admin-form qisutu-admin-form-wide qisutu-cmdb-field-form" method="post" action="[% FormAction %]" data-qisutu-cmdb-field-form><input type="hidden" name="Page" value="AdminCMDBTypes"><input type="hidden" name="Step" value="FieldSave"><input type="hidden" name="TypeID" value="[% TypeID %]"><input type="hidden" name="FieldID" value="[% FieldID %]"><h3>[% IF ShowFieldEdit %][% Translate.CMDBFieldEdit %][% ELSE %][% Translate.CMDBFieldCreate %][% END %]</h3><div class="qisutu-admin-form-columns"><div class="qisutu-form-field"><label>[% Translate.CMDBFieldKey %] *</label><input type="text" name="FieldKey" value="[% FieldKey %]" [% FieldKeyReadonly %] required></div><div class="qisutu-form-field"><label>[% Translate.CMDBFieldGroup %]</label><select name="GroupID">[% RAW.FieldGroupOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBFieldLabel %] *</label><input type="text" name="Label" value="[% FieldLabel %]" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBFieldType %]</label><select name="FieldType" data-qisutu-cmdb-field-type>[% RAW.FieldTypeOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.AdminSortOrder %]</label><input type="number" name="SortOrder" value="[% FieldSortOrder %]" min="0"></div><div class="qisutu-form-field"><label>[% Translate.CMDBDefaultValue %]</label><input type="text" name="DefaultValue" value="[% FieldDefaultValue %]"></div></div><div class="qisutu-form-field [% FieldOptionsClass %]" data-qisutu-cmdb-field-options><label>[% Translate.CMDBOptions %] *</label><textarea name="OptionsText" rows="7" placeholder="hardware|Hardware&#10;software|Software">[% FieldOptionsText %]</textarea><span class="qisutu-form-hint">[% Translate.CMDBOptionsHelp %]</span></div><div class="qisutu-cmdb-checkbox-row"><label class="qisutu-form-checkbox"><input type="checkbox" name="IsRequired" value="1" [% FieldRequiredChecked %]><span>[% Translate.CMDBRequired %]</span></label><label class="qisutu-form-checkbox"><input type="checkbox" name="IsSearchable" value="1" [% FieldSearchableChecked %]><span>[% Translate.CMDBSearchable %]</span></label><label class="qisutu-form-checkbox"><input type="checkbox" name="IsUnique" value="1" [% FieldUniqueChecked %]><span>[% Translate.CMDBUnique %]</span></label><label class="qisutu-form-checkbox"><input type="checkbox" name="CustomerVisible" value="1" [% FieldCustomerVisibleChecked %]><span>[% Translate.CMDBCustomerVisible %]</span></label><label class="qisutu-form-checkbox"><input type="checkbox" name="Active" value="1" [% FieldActiveChecked %]><span>[% Translate.AdminActive %]</span></label></div><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>[% IF ShowFieldEdit %]<a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminCMDBTypes;Action=Edit;TypeID=[% TypeID %]">[% Translate.AdminCancel %]</a>[% END %]</div></form>
    </section>
    [% END %]
</section>

<script src="[% StaticBase %]/js/qisutu-cmdb.js?v=2026071801"></script>
