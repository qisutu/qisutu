<div class="qisutu-app">
    <aside class="qisutu-sidebar" aria-label="[% Translate.Navigation %]">
        <div class="qisutu-sidebar-brand">
            <span class="qisutu-sidebar-logo">
                <img src="[% StaticBase %]/img/logo.png" alt="Qisutu">
            </span>
            <span class="qisutu-sidebar-name">[% SystemName %]</span>
        </div>

        <nav class="qisutu-nav">
            [% RAW.NavigationHTML %]
        </nav>

        <div class="qisutu-sidebar-user">
            <div class="qisutu-sidebar-user-avatar">[% UserInitials %]</div>
            <div class="qisutu-sidebar-user-text">
                <div class="qisutu-sidebar-user-name">[% UserDisplayName %]</div>
                <div class="qisutu-sidebar-user-links">
                    <a class="qisutu-sidebar-user-link" href="index.pl?Page=Logout">[% Translate.StartLogout %]</a>
                </div>
            </div>
            [% IF UserHasPreferences %]
                <a class="qisutu-sidebar-user-settings" href="[% UserPreferencesURL %]" title="[% UserPreferencesTitle %]" aria-label="[% UserPreferencesTitle %]">⚙</a>
            [% END %]
        </div>
    </aside>

    <section class="qisutu-workspace">
        <main class="qisutu-main">
