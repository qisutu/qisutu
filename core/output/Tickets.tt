            <section class="qisutu-dashboard" aria-labelledby="qisutu-tickets-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-tickets-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                </div>

                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <h2>[% Translate.TicketListTitle %]</h2>
                        <div class="qisutu-panel-actions">
                            [% IF CanCustomerTicketCreate %]
                            <a class="qisutu-button qisutu-button-primary" href="#qisutu-customer-ticket-create">[% Translate.TicketCreateNew %]</a>
                            [% END %]
                            <span class="qisutu-panel-counter">[% TicketCount %]</span>
                        </div>
                    </div>

                    [% IF HasTickets %]
                    <div class="qisutu-table-wrap">
                        <table class="qisutu-table">
                            <thead>
                                <tr>
                                    <th>[% Translate.TicketNumber %]</th>
                                    <th>[% Translate.TicketTitle %]</th>
                                    <th>[% Translate.TicketQueue %]</th>
                                    <th>[% Translate.TicketState %]</th>
                                    <th>[% Translate.TicketPriority %]</th>
                                    <th>[% Translate.TicketCustomer %]</th>
                                    <th>[% Translate.TicketOwner %]</th>
                                    <th>[% Translate.TicketChanged %]</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH Ticket IN Tickets %]
                                <tr>
                                    <td class="qisutu-table-number">
                                        <a href="[% Ticket.ticket_zoom_url %]">[% Ticket.ticket_number %]</a>
                                    </td>
                                    <td>[% Ticket.title %]</td>
                                    <td>[% Ticket.queue_name %]</td>
                                    <td>[% Ticket.state_name_display %]</td>
                                    <td>[% Ticket.priority_name_display %]</td>
                                    <td>
                                        <span>[% Ticket.customer_name %]</span>
                                        <span class="qisutu-table-muted">[% Ticket.customer_user_name %]</span>
                                    </td>
                                    <td>[% Ticket.owner_name %]</td>
                                    <td>[% Ticket.changed_at %]</td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>
                    </div>
                    [% ELSE %]
                    <div class="qisutu-empty">
                        <strong>[% Translate.TicketListEmptyTitle %]</strong>
                        <p>[% Translate.TicketListEmptyText %]</p>
                    </div>
                    [% END %]
                </section>

                [% IF CanCustomerTicketCreate %]
                <section id="qisutu-customer-ticket-create" class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <h2>[% Translate.TicketCreateNew %]</h2>
                    </div>

                    <div class="qisutu-form-error [% CreateErrorClass %]">[% CreateError %]</div>

                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="Tickets">
                        <input type="hidden" name="Step" value="CustomerTicketCreate">

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label>[% Translate.TicketArticleSubject %]</label>
                                <input type="text" name="Title" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.TicketQueue %]</label>
                                <select name="QueueID" required>
                                    [% RAW.QueueOptionsHTML %]
                                </select>
                            </div>
                        </div>

                        <div class="qisutu-form-field">
                            <label>[% Translate.TicketArticleBody %]</label>
                            <textarea id="qisutu-customer-ticket-body" class="qisutu-richtext" name="Body" rows="8"></textarea>
                        </div>

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketCreateSubmit %]</button>
                        </div>
                    </form>
                </section>
                [% END %]
            </section>
            [% IF CanCustomerTicketCreate %]
            <script>
                window.QISUTU_STATIC_BASE = '[% StaticBase %]';
            </script>
            <script src="[% StaticBase %]/js/ckeditor5/ckeditor5.umd.js"></script>
            <script src="[% StaticBase %]/js/qisutu-richtext.js"></script>
            [% END %]
