<!doctype html>
<html lang="[% Language %]">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="[% Robots %]">

    <title>[% PageTitle %]</title>

    <link rel="stylesheet" href="[% StaticBase %]/css/qisutu.css?v=2026071701">
    <link rel="stylesheet" href="[% StaticBase %]/css/ckeditor5/ckeditor5.css">
    <link rel="stylesheet" href="[% StaticBase %]/css/[% PageCSS %]">

    <script>
        (function () {
            try {
                if (window.localStorage.getItem('qisutu.sidebar.collapsed') === '1') {
                    document.documentElement.classList.add('qisutu-sidebar-collapsed');
                }
            }
            catch (Error) {
                // Use the expanded navigation when browser storage is unavailable.
            }
        }());
    </script>
</head>
<body class="[% BodyClass %]">
