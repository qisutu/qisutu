<div class="qisutu-dashboard">
    <header class="qisutu-dashboard-header">
        <div>
            <h1 id="qisutu-agent-preferences-title">[% ProgramTitle %]</h1>
            <p>[% ProgramDescription %]</p>
        </div>
    </header>

    <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>
    <div class="qisutu-form-error qisutu-form-success [% SuccessClass %]">[% SuccessMessage %]</div>

    <form class="qisutu-admin-form" method="post" action="[% FormAction %]">
        <input type="hidden" name="Page" value="AgentPreferences">
        <input type="hidden" name="Step" value="PreferenceSave">

        <section class="qisutu-panel">
            <div class="qisutu-panel-header">
                <h2>[% Translate.PreferencesGeneral %]</h2>
            </div>

            <div class="qisutu-admin-form-columns">
                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesLanguage %]</label>
                    <select name="PreferenceLanguage">
                        [% RAW.LanguageOptions %]
                    </select>
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesTimezone %]</label>
                    <select name="Timezone">
                        [% RAW.TimezoneOptions %]
                    </select>
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesTheme %]</label>
                    <select name="Theme">
                        [% RAW.ThemeOptions %]
                    </select>
                    <span class="qisutu-form-hint">[% Translate.PreferencesThemeHint %]</span>
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesStartPage %]</label>
                    <select name="StartPage">
                        <option value="Dashboard" [% StartPageDashboardSelected %]>[% Translate.NavigationDashboard %]</option>
                        <option value="AgentTicketList" [% StartPageTicketListSelected %]>[% Translate.AgentTicketListTitle %]</option>
                    </select>
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesTicketListLimit %]</label>
                    <select name="TicketListLimit">
                        <option value="10" [% TicketListLimit10Selected %]>10</option>
                        <option value="20" [% TicketListLimit20Selected %]>20</option>
                        <option value="30" [% TicketListLimit30Selected %]>30</option>
                        <option value="40" [% TicketListLimit40Selected %]>40</option>
                        <option value="50" [% TicketListLimit50Selected %]>50</option>
                    </select>
                </div>
            </div>
        </section>

        <section class="qisutu-panel">
            <div class="qisutu-panel-header">
                <div>
                    <h2>[% Translate.PreferencesNotifications %]</h2>
                    <span class="qisutu-panel-subtitle">[% Translate.PreferencesNotificationsHint %]</span>
                </div>
            </div>

            <div class="qisutu-preference-checkbox-grid">
                <label class="qisutu-form-checkbox">
                    <input type="checkbox" name="NotificationNewTicket" value="1" [% NotificationNewTicketChecked %]>
                    <span>[% Translate.PreferencesNotifyNewTicket %]</span>
                </label>
                <label class="qisutu-form-checkbox">
                    <input type="checkbox" name="NotificationCustomerReply" value="1" [% NotificationCustomerReplyChecked %]>
                    <span>[% Translate.PreferencesNotifyCustomerReply %]</span>
                </label>
                <label class="qisutu-form-checkbox">
                    <input type="checkbox" name="NotificationAssignedTicket" value="1" [% NotificationAssignedTicketChecked %]>
                    <span>[% Translate.PreferencesNotifyAssignedTicket %]</span>
                </label>
                <label class="qisutu-form-checkbox">
                    <input type="checkbox" name="NotificationStatusChange" value="1" [% NotificationStatusChangeChecked %]>
                    <span>[% Translate.PreferencesNotifyStatusChange %]</span>
                </label>
            </div>
        </section>

        <section class="qisutu-panel">
            <div class="qisutu-panel-header">
                <h2>[% Translate.PreferencesAbsence %]</h2>
            </div>

            <div class="qisutu-admin-form-columns">
                <label class="qisutu-form-checkbox qisutu-form-field-wide">
                    <input type="checkbox" name="AbsenceActive" value="1" [% AbsenceActiveChecked %]>
                    <span>[% Translate.PreferencesAbsenceActive %]</span>
                </label>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesAbsenceStart %]</label>
                    <input type="datetime-local" name="AbsenceStart" value="[% AbsenceStart %]">
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesAbsenceEnd %]</label>
                    <input type="datetime-local" name="AbsenceEnd" value="[% AbsenceEnd %]">
                </div>

                <div class="qisutu-form-field qisutu-form-field-wide">
                    <label>[% Translate.PreferencesReplacementAgent %]</label>
                    <select name="AbsenceReplacementUserID">
                        [% RAW.AbsenceReplacementOptions %]
                    </select>
                </div>

                <div class="qisutu-form-field qisutu-form-field-wide">
                    <label>[% Translate.PreferencesAbsenceNote %]</label>
                    <textarea name="AbsenceNote">[% AbsenceNote %]</textarea>
                </div>
            </div>
        </section>

        <section class="qisutu-panel">
            <div class="qisutu-panel-header">
                <h2>[% Translate.PreferencesTicketWork %]</h2>
            </div>

            <div class="qisutu-admin-form-columns">
                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesAfterReplyAction %]</label>
                    <select name="TicketAfterReplyAction">
                        <option value="stay" [% AfterReplyStaySelected %]>[% Translate.PreferencesAfterReplyStay %]</option>
                        <option value="list" [% AfterReplyListSelected %]>[% Translate.PreferencesAfterReplyList %]</option>
                        <option value="next" [% AfterReplyNextSelected %]>[% Translate.PreferencesAfterReplyNext %]</option>
                    </select>
                </div>
            </div>
        </section>

        <section class="qisutu-panel">
            <div class="qisutu-panel-header">
                <h2>[% Translate.PreferencesPassword %]</h2>
            </div>

            <div class="qisutu-admin-form-columns">
                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesCurrentPassword %]</label>
                    <input type="password" name="CurrentPassword" value="" autocomplete="current-password">
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesNewPassword %]</label>
                    <input type="password" name="NewPassword" value="" autocomplete="new-password">
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesNewPasswordRepeat %]</label>
                    <input type="password" name="NewPasswordRepeat" value="" autocomplete="new-password">
                </div>
            </div>
        </section>

        <div class="qisutu-form-actions">
            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>
        </div>
    </form>
    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.TwoFactorTitle %]</h2><span class="qisutu-panel-subtitle">[% Translate.TwoFactorPreferencesDescription %]</span></div></div>
        [% IF ShowRecoveryCodes %]
        <div class="qisutu-form-error qisutu-form-success"><strong>[% Translate.TwoFactorRecoveryCodesTitle %]</strong><p>[% Translate.TwoFactorRecoveryCodesDescription %]</p><ul class="qisutu-recovery-code-list">[% RAW.RecoveryCodesHTML %]</ul><p>[% Translate.TwoFactorRecoveryCodesOnce %]</p></div>
        [% END %]
        [% IF TwoFactorSetup %]
        <div class="qisutu-two-factor-setup-grid">
            <div>
                <p>[% Translate.TwoFactorSetupScanHint %]</p>
                <div class="qisutu-two-factor-qr" data-qisutu-two-factor-uri="[% TwoFactorProvisioningURI %]" data-qisutu-two-factor-label="[% Translate.TwoFactorQRCodeLabel %]"></div>
            </div>
            <div>
                <p>[% Translate.TwoFactorSetupManualHint %]</p>
                <code class="qisutu-two-factor-secret">[% TwoFactorSecret %]</code>
            </div>
        </div>
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AgentPreferences"><input type="hidden" name="Step" value="TwoFactorEnable"><div class="qisutu-form-field"><label>[% Translate.TwoFactorAuthenticatorCode %]</label><input type="text" name="TwoFactorCode" inputmode="numeric" autocomplete="one-time-code" required></div><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TwoFactorEnable %]</button></form>
        <script src="[% StaticBase %]/js/qrcode-generator/qrcode.js?v=2.0.4"></script>
        <script src="[% StaticBase %]/js/qisutu-two-factor.js?v=2026072001"></script>
        [% ELSE %]
        [% IF TwoFactorEnabled %]
        <p>[% Translate.TwoFactorEnabledText %] [% TwoFactorRecoveryRemaining %]</p>
        <div class="qisutu-admin-form-columns">
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AgentPreferences"><input type="hidden" name="Step" value="TwoFactorRecoveryRegenerate"><div class="qisutu-form-field"><label>[% Translate.TwoFactorAuthenticatorCode %]</label><input type="text" name="TwoFactorCode" inputmode="numeric" required></div><button class="qisutu-button qisutu-button-secondary" type="submit">[% Translate.TwoFactorRecoveryRegenerate %]</button></form>
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AgentPreferences"><input type="hidden" name="Step" value="TwoFactorDisable"><div class="qisutu-form-field"><label>[% Translate.TwoFactorCodeOrRecoveryCode %]</label><input type="text" name="TwoFactorCode" required></div><button class="qisutu-button qisutu-button-danger" type="submit">[% Translate.TwoFactorDisable %]</button></form>
        </div>
        [% ELSE %]
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AgentPreferences"><input type="hidden" name="Step" value="TwoFactorStart"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TwoFactorStart %]</button></form>
        [% END %]
        [% END %]
    </section>
</div>
