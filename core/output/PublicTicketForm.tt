<!doctype html>
<html lang="[% Language %]">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>[% PublicFormTitle %] – [% SystemName %]</title>
    <link rel="icon" type="image/x-icon" sizes="32x32" href="[% StaticBase %]/img/favicon.ico?v=2026072101">
    <link rel="apple-touch-icon" sizes="120x120" href="[% StaticBase %]/img/apple-touch-icon.png?v=2026072101">
    <link rel="stylesheet" href="[% StaticBase %]/css/qisutu-ticket-form-public.css?v=2026082802">
</head>
<body>
    <main class="qisutu-public-form-shell">
        <section class="qisutu-public-form-card">
            [% IF NotFound %]
            <div class="qisutu-public-form-state qisutu-public-form-error">
                <h1>[% Translate.PublicTicketFormNotFound %]</h1>
            </div>
            [% ELSE %]
                [% IF HasLanguageLinks %]
                <nav class="qisutu-public-form-languages" aria-label="[% Translate.AdminTranslationLanguage %]">
                    [% FOREACH LanguageLink IN LanguageLinks %]
                    <a href="[% LanguageLink.url %]" class="[% LanguageLink.active_class %]" [% RAW.LanguageLink.aria_current %]>[% LanguageLink.code %]</a>
                    [% END %]
                </nav>
                [% END %]
                [% IF Success %]
                <div class="qisutu-public-form-state qisutu-public-form-success">
                    <div class="qisutu-public-form-mark" aria-hidden="true">✓</div>
                    <h1>[% Translate.PublicTicketFormSuccessTitle %]</h1>
                    <p>[% ConfirmationText %]</p>
                    [% IF HasTicketNumber %]<p class="qisutu-public-form-ticket-number">[% Translate.PublicTicketFormTicketNumber %]: <strong>[% TicketNumber %]</strong></p>[% END %]
                </div>
                [% ELSE %]
                <header class="qisutu-public-form-header">
                    <span class="qisutu-public-form-brand">[% SystemName %]</span>
                    <h1>[% PublicFormTitle %]</h1>
                    <p>[% PublicFormDescription %]</p>
                </header>
                <div class="qisutu-form-error [% FormErrorClass %]">[% FormError %]</div>
                <form class="qisutu-public-form" method="post" action="[% FormAction %]" enctype="multipart/form-data">
                    <input type="hidden" name="Step" value="PublicTicketFormSubmit">
                    <input type="hidden" name="FormID" value="[% FormID %]">
                    <input type="hidden" name="FormStartedAt" value="[% FormStartedAt %]">
                    <div class="qisutu-public-form-honeypot" aria-hidden="true">
                        <label>Website<input type="text" name="Website" tabindex="-1" autocomplete="off"></label>
                    </div>
                    [% RAW.PublicFormFieldsHTML %]
                    <div class="qisutu-form-field qisutu-public-form-attachments">
                        <label for="qisutu-public-ticket-attachments">[% Translate.TicketArticleAttachments %]</label>
                        <input id="qisutu-public-ticket-attachments" type="file" name="TicketAttachment" multiple data-qisutu-attachment-input data-qisutu-attachment-max-bytes="[% AttachmentMaxSizeBytes %]" data-qisutu-attachment-max-label="[% AttachmentMaxSizeMB %] MB">
                        <div class="qisutu-ticket-reply-attachment-list" data-qisutu-attachment-list data-qisutu-attachment-remove-label="[% Translate.TicketArticleAttachmentRemove %]">
                            <p class="qisutu-form-hint" data-qisutu-attachment-empty>[% Translate.TicketArticleAttachmentsEmpty %]</p>
                        </div>
                        <span class="qisutu-form-hint">[% Translate.TicketArticleAttachmentLimitHelp %] [% AttachmentMaxSizeMB %] MB</span>
                    </div>
                    <div class="qisutu-public-form-actions">
                        <button type="submit">[% PublicFormSubmitLabel %]</button>
                    </div>
                    <p class="qisutu-public-form-privacy">[% Translate.PublicTicketFormPrivacy %]</p>
                </form>
                [% END %]
            [% END %]
        </section>
    </main>
    <div class="qisutu-attachment-limit-overlay" data-qisutu-attachment-limit-overlay hidden>
        <div class="qisutu-attachment-limit-dialog" role="alertdialog" aria-modal="true" aria-labelledby="qisutu-public-ticket-attachment-limit-title">
            <h3 id="qisutu-public-ticket-attachment-limit-title">[% Translate.TicketArticleAttachmentTooLargeTitle %]</h3>
            <p data-qisutu-attachment-limit-message data-qisutu-message-template="[% Translate.TicketArticleAttachmentTooLargeMessage %]"></p>
            <p>[% Translate.TicketArticleAttachmentTooLargeAdmin %]</p>
            <button type="button" data-qisutu-attachment-limit-close>[% Translate.TicketArticleAttachmentDialogOK %]</button>
        </div>
    </div>
    <script src="[% StaticBase %]/js/qisutu-customer-ticket-create.js?v=2026082802"></script>
</body>
</html>
