            <section class="qisutu-dashboard qisutu-agent-ticket-list" aria-labelledby="qisutu-agent-ticket-list-title">
                <div class="qisutu-dashboard-header qisutu-ticket-list-page-header">
                    <div>
                        <h1 id="qisutu-agent-ticket-list-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                </div>

                <div class="qisutu-alert qisutu-alert-error [% ErrorClass %]">[% ErrorMessage %]</div>
                [% RAW.BulkActionResultHTML %]

                <section class="qisutu-panel qisutu-ticket-list-panel">
                    <div class="qisutu-ticket-list-toolbar">
                        <div class="qisutu-ticket-list-toolbar-left">
                            <div class="qisutu-ticket-list-view-select" data-qisutu-ticket-list-view-select>
                                <button class="qisutu-button qisutu-button-secondary qisutu-ticket-list-view-button" type="button" aria-expanded="false" data-qisutu-ticket-list-view-button>
                                    <span>[% Translate.TicketListSelectView %]</span>
                                    <strong>[% ActiveViewLabel %]</strong>
                                    <span class="qisutu-ticket-list-view-chevron" aria-hidden="true"></span>
                                </button>
                                <div class="qisutu-ticket-list-view-menu" data-qisutu-ticket-list-view-menu hidden>
                                    [% RAW.ViewMenuHTML %]
                                </div>
                            </div>

                            <button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-ticket-list-columns-open>
                                [% Translate.TicketListSelectColumns %]
                            </button>

                            <button class="qisutu-button qisutu-button-secondary qisutu-ticket-bulk-open-button" type="button" data-qisutu-ticket-bulk-open disabled aria-disabled="true">
                                <span>[% Translate.TicketBulkActionTitle %]</span>
                                <strong>(<span data-qisutu-ticket-bulk-button-count>0</span>)</strong>
                            </button>
                            <button class="qisutu-button qisutu-button-secondary qisutu-ticket-bulk-clear-button" type="button" data-qisutu-ticket-bulk-clear hidden>
                                [% Translate.TicketBulkActionClearSelection %]
                            </button>

                            <button class="qisutu-button qisutu-button-secondary qisutu-ticket-search-open-button" type="button" data-qisutu-ticket-search-open>
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4.2-4.2"></path></svg>
                                <span>[% Translate.TicketSearchTitle %]</span>
                            </button>
                        </div>

                        <div class="qisutu-ticket-list-toolbar-right">
                            [% RAW.PerPageHTML %]
                            [% RAW.PaginationTopHTML %]
                            <span class="qisutu-panel-counter" title="[% Translate.TicketListTotalTickets %]">[% TicketCount %]</span>
                        </div>
                    </div>

                    [% RAW.SearchStatusHTML %]
                    [% RAW.FilterHTML %]

                    [% IF HasTickets %]
                    [% RAW.TableHTML %]
                    [% IF PaginationBottomHTML %]
                    <div class="qisutu-ticket-list-pagination-bottom">
                        [% RAW.PaginationBottomHTML %]
                    </div>
                    [% END %]
                    [% ELSE %]
                    <div class="qisutu-empty">
                        <strong>[% Translate.TicketListEmptyTitle %]</strong>
                        <p>[% Translate.TicketListEmptyText %]</p>
                    </div>
                    [% END %]
                </section>

                <div class="qisutu-ticket-list-column-overlay" data-qisutu-ticket-list-columns-overlay hidden>
                    <section class="qisutu-ticket-list-column-dialog" role="dialog" aria-modal="true" aria-labelledby="qisutu-ticket-list-columns-title">
                        <header class="qisutu-ticket-list-column-header">
                            <div>
                                <h2 id="qisutu-ticket-list-columns-title">[% Translate.TicketListSelectColumns %]</h2>
                                <p>[% Translate.TicketListSelectColumnsHint %]</p>
                            </div>
                            <button class="qisutu-ticket-list-column-close" type="button" aria-label="[% Translate.AdminCancel %]" data-qisutu-ticket-list-columns-close>×</button>
                        </header>
                        [% RAW.ColumnChooserHTML %]
                    </section>
                </div>

                [% RAW.SearchOverlayHTML %]
                [% RAW.BulkActionOverlayHTML %]
            </section>
            <script src="[% StaticBase %]/js/qisutu-ticket-list.js?v=2026071702"></script>
