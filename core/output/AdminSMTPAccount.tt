            <section class="qisutu-dashboard" aria-labelledby="qisutu-admin-smtp-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-admin-smtp-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                </div>

                <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>
                <div class="qisutu-form-error [% TestClass %]">[% TestMessage %]</div>

                [% IF ShowList %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminSMTPAccountList %]</h2>
                            <span class="qisutu-panel-subtitle">[% AccountCount %] [% Translate.AdminEntries %]</span>
                        </div>
                        <div class="qisutu-panel-actions">
                            <a class="qisutu-button qisutu-button-primary" href="index.pl?Page=AdminSMTPAccount;Action=Create">[% Translate.AdminSMTPAccountCreate %]</a>
                        </div>
                    </div>
                    <div class="qisutu-admin-help">
                        <strong>[% Translate.AdminSMTPTransportHintTitle %]</strong>
                        <span>[% Translate.AdminSMTPTransportHintText %]</span>
                    </div>
                    <div class="qisutu-table-wrap">
                        <table class="qisutu-table qisutu-table-compact">
                            <thead>
                                <tr>
                                    <th>[% Translate.AdminName %]</th>
                                    <th>[% Translate.AdminHost %]</th>
                                    <th>[% Translate.AdminPort %]</th>
                                    <th>[% Translate.AdminActive %]</th>
                                    <th>[% Translate.AdminAction %]</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH Account IN AccountList %]
                                <tr>
                                    <td><a class="qisutu-table-link" href="index.pl?Page=AdminSMTPAccount;Action=Edit;AccountID=[% Account.id %]">[% Account.name %]</a></td>
                                    <td>[% Account.smtp_host %]</td>
                                    <td>[% Account.smtp_port %]</td>
                                    <td>[% Account.active_label %]</td>
                                    <td>
                                        <form class="qisutu-inline-form" method="post" action="[% FormAction %]">
                                            <input type="hidden" name="Page" value="AdminSMTPAccount">
                                            <input type="hidden" name="Step" value="SMTPAccountDeactivate">
                                            <input type="hidden" name="AccountID" value="[% Account.id %]">
                                            <button class="qisutu-button qisutu-button-danger qisutu-button-small" type="submit">[% Translate.AdminDeactivate %]</button>
                                        </form>
                                    </td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>
                    </div>
                </section>
                [% END %]

                [% IF ShowCreate %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <h2>[% Translate.AdminSMTPAccountCreate %]</h2>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminSMTPAccount">[% Translate.AdminBackToList %]</a>
                    </div>
                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="AdminSMTPAccount">
                        <input type="hidden" name="Step" value="SMTPAccountCreate">
                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminName %]</label>
                                <input type="text" name="Name" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminSMTPSecurity %]</label>
                                <select name="SMTPSecurity" data-qisutu-port-target="SMTPPort">
                                    [% RAW.CreateSMTPSecurityOptionsHTML %]
                                </select>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminHost %]</label>
                                <input type="text" name="SMTPHost" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminPort %]</label>
                                <input type="number" name="SMTPPort" value="587" min="1">
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminAuthType %]</label>
                                <select name="SMTPAuthType">
                                    [% RAW.CreateSMTPAuthOptionsHTML %]
                                </select>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminUsername %]</label>
                                <input type="text" name="SMTPUsername" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminPassword %]</label>
                                <input type="password" name="SMTPPassword" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminSortOrder %]</label>
                                <input type="number" name="SortOrder" value="1000" min="1">
                            </div>
                            <label class="qisutu-form-checkbox qisutu-admin-active-checkbox">
                                <input type="checkbox" name="Active" value="1" checked>
                                <span>[% Translate.AdminActive %]</span>
                            </label>
                        </div>
                        <div class="qisutu-admin-form-block">
                            <h3>[% Translate.AdminOAuth2 %]</h3>
                            <div class="qisutu-admin-form-columns">
                                <div class="qisutu-form-field">
                                    <label>[% Translate.AdminOAuthProvider %]</label>
                                    <input type="text" name="OAuthProvider">
                                </div>
                                <div class="qisutu-form-field">
                                    <label>[% Translate.AdminOAuthTenantID %]</label>
                                    <input type="text" name="OAuthTenantID">
                                </div>
                                <div class="qisutu-form-field">
                                    <label>[% Translate.AdminOAuthClientID %]</label>
                                    <input type="text" name="OAuthClientID">
                                </div>
                                <div class="qisutu-form-field">
                                    <label>[% Translate.AdminOAuthClientSecret %]</label>
                                    <input type="password" name="OAuthClientSecret">
                                </div>
                                <div class="qisutu-form-field qisutu-form-field-wide">
                                    <label>[% Translate.AdminOAuthScope %]</label>
                                    <input type="text" name="OAuthScope">
                                </div>
                            </div>
                        </div>
                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminCreate %]</button>
                        </div>
                    </form>
                </section>
                [% END %]

                [% IF ShowEdit %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminSMTPAccountEdit %]</h2>
                            <span class="qisutu-panel-subtitle">[% AccountName %]</span>
                        </div>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminSMTPAccount">[% Translate.AdminBackToList %]</a>
                    </div>
                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="AdminSMTPAccount">
                        <input type="hidden" name="Step" value="SMTPAccountUpdate">
                        <input type="hidden" name="AccountID" value="[% AccountID %]">
                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminName %]</label>
                                <input type="text" name="Name" value="[% AccountName %]" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminSMTPSecurity %]</label>
                                <select name="SMTPSecurity" data-qisutu-port-target="SMTPPort">
                                    [% RAW.EditSMTPSecurityOptionsHTML %]
                                </select>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminHost %]</label>
                                <input type="text" name="SMTPHost" value="[% AccountSMTPHost %]" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminPort %]</label>
                                <input type="number" name="SMTPPort" value="[% AccountSMTPPort %]" min="1">
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminAuthType %]</label>
                                <select name="SMTPAuthType">
                                    [% RAW.EditSMTPAuthOptionsHTML %]
                                </select>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminUsername %]</label>
                                <input type="text" name="SMTPUsername" value="[% AccountSMTPUsername %]" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminPassword %]</label>
                                <input type="password" name="SMTPPassword" placeholder="[% Translate.AdminPasswordKeep %]">
                            </div>
                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminSortOrder %]</label>
                                <input type="number" name="SortOrder" value="[% AccountSortOrder %]" min="1">
                            </div>
                            <label class="qisutu-form-checkbox qisutu-admin-active-checkbox">
                                <input type="checkbox" name="Active" value="1" [% AccountActiveChecked %]>
                                <span>[% Translate.AdminActive %]</span>
                            </label>
                        </div>
                        <div class="qisutu-admin-form-block">
                            <h3>[% Translate.AdminOAuth2 %]</h3>
                            <div class="qisutu-admin-form-columns">
                                <div class="qisutu-form-field">
                                    <label>[% Translate.AdminOAuthProvider %]</label>
                                    <input type="text" name="OAuthProvider" value="[% AccountOAuthProvider %]">
                                </div>
                                <div class="qisutu-form-field">
                                    <label>[% Translate.AdminOAuthTenantID %]</label>
                                    <input type="text" name="OAuthTenantID" value="[% AccountOAuthTenantID %]">
                                </div>
                                <div class="qisutu-form-field">
                                    <label>[% Translate.AdminOAuthClientID %]</label>
                                    <input type="text" name="OAuthClientID" value="[% AccountOAuthClientID %]">
                                </div>
                                <div class="qisutu-form-field">
                                    <label>[% Translate.AdminOAuthClientSecret %]</label>
                                    <input type="password" name="OAuthClientSecret" placeholder="[% Translate.AdminPasswordKeep %]">
                                </div>
                                <div class="qisutu-form-field qisutu-form-field-wide">
                                    <label>[% Translate.AdminOAuthScope %]</label>
                                    <input type="text" name="OAuthScope" value="[% AccountOAuthScope %]">
                                </div>
                            </div>
                        </div>
                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>
                        </div>
                    </form>
                </section>

                <section class="qisutu-panel qisutu-admin-definition-panel">
                    <div class="qisutu-panel-header">
                        <h2>[% Translate.AdminConnectionTest %]</h2>
                    </div>
                    <form class="qisutu-inline-form" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="AdminSMTPAccount">
                        <input type="hidden" name="Step" value="SMTPAccountTest">
                        <input type="hidden" name="Action" value="Edit">
                        <input type="hidden" name="AccountID" value="[% AccountID %]">
                        <button class="qisutu-button qisutu-button-secondary" type="submit">[% Translate.AdminTestSMTP %]</button>
                    </form>
                </section>
                [% END %]
            </section>

            <script src="[% StaticBase %]/js/qisutu-mail-account.js"></script>
