            <section class="qisutu-dashboard qisutu-agent-ticket-create" aria-labelledby="qisutu-agent-ticket-create-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-agent-ticket-create-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                    <a class="qisutu-button qisutu-button-secondary" href="[% TicketListURL %]">[% Translate.TicketBackToList %]</a>
                </div>

                <section class="qisutu-panel">
                    <div class="qisutu-form-error [% CreateErrorClass %]" data-qisutu-create-error>[% CreateError %]</div>

                    [% IF HasQueueOptions %]
                    <form class="qisutu-admin-form qisutu-agent-ticket-create-form" method="post" action="[% FormAction %]" enctype="multipart/form-data" data-qisutu-agent-ticket-create-form>
                        <input type="hidden" name="Page" value="AgentTicketCreate">
                        <input type="hidden" name="Step" value="AgentTicketCreate">

                        <div class="qisutu-agent-ticket-create-send">
                            <label class="qisutu-form-checkbox" for="qisutu-agent-ticket-create-send-email">
                                <input id="qisutu-agent-ticket-create-send-email" type="checkbox" name="SendEmail" value="1" [% RAW.SendEmailChecked %]>
                                <span>[% Translate.AgentTicketCreateSendEmail %]</span>
                            </label>
                        </div>

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label for="qisutu-agent-ticket-create-queue">[% Translate.TicketQueue %] *</label>
                                <select id="qisutu-agent-ticket-create-queue" name="QueueID" required data-qisutu-create-queue data-qisutu-template-url="index.pl?Page=AgentTicketCreate&amp;Step=QueueTemplate">
                                    [% RAW.QueueOptionsHTML %]
                                </select>
                            </div>

                            <div class="qisutu-form-field qisutu-autocomplete">
                                <label for="qisutu-agent-ticket-create-customer-user">[% Translate.AgentTicketCreateToCustomerUser %] *</label>
                                <input type="hidden" id="qisutu-agent-ticket-create-customer-user-id" name="CustomerUserID" value="[% CustomerUserID %]" data-qisutu-autocomplete-target>
                                <input id="qisutu-agent-ticket-create-customer-user" type="text" name="CustomerUserSearch" value="[% CustomerUserSearch %]" required autocomplete="off" placeholder="[% Translate.TicketToolCustomerSearchPlaceholder %]" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketCreate&amp;Step=CustomerUserLookup" data-qisutu-autocomplete-hidden="qisutu-agent-ticket-create-customer-user-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]">
                                <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                <span class="qisutu-form-hint">[% Translate.TicketToolCustomerSearchHelp %]</span>
                            </div>

                            <div class="qisutu-form-field">
                                <label for="qisutu-agent-ticket-create-cc">[% Translate.TicketArticleReplyCc %]</label>
                                <input id="qisutu-agent-ticket-create-cc" type="text" name="Cc" value="[% Cc %]" autocomplete="off" placeholder="name@example.com">
                                <span class="qisutu-form-hint">[% Translate.TicketArticleReplyCcHelp %]</span>
                            </div>

                            <div class="qisutu-form-field qisutu-autocomplete">
                                <label for="qisutu-agent-ticket-create-owner">[% Translate.TicketOwner %]</label>
                                <input type="hidden" id="qisutu-agent-ticket-create-owner-id" name="OwnerUserID" value="[% OwnerUserID %]" data-qisutu-autocomplete-target>
                                <input id="qisutu-agent-ticket-create-owner" type="text" name="OwnerUserSearch" value="[% OwnerUserSearch %]" autocomplete="off" placeholder="[% Translate.TicketToolOwnerSearchPlaceholder %]" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketCreate&amp;Step=AgentLookup" data-qisutu-autocomplete-hidden="qisutu-agent-ticket-create-owner-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]">
                                <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                <span class="qisutu-form-hint">[% Translate.AgentTicketCreateOwnerHelp %]</span>
                            </div>

                            <div class="qisutu-form-field qisutu-autocomplete">
                                <label for="qisutu-agent-ticket-create-responsible">[% Translate.TicketResponsible %]</label>
                                <input type="hidden" id="qisutu-agent-ticket-create-responsible-id" name="ResponsibleUserID" value="[% ResponsibleUserID %]" data-qisutu-autocomplete-target>
                                <input id="qisutu-agent-ticket-create-responsible" type="text" name="ResponsibleUserSearch" value="[% ResponsibleUserSearch %]" autocomplete="off" placeholder="[% Translate.TicketToolResponsibleSearchPlaceholder %]" data-qisutu-autocomplete data-qisutu-autocomplete-url="index.pl?Page=AgentTicketCreate&amp;Step=AgentLookup" data-qisutu-autocomplete-hidden="qisutu-agent-ticket-create-responsible-id" data-qisutu-autocomplete-min="2" data-qisutu-autocomplete-empty="[% Translate.TicketToolSearchNoResults %]" data-qisutu-autocomplete-loading="[% Translate.TicketToolSearchLoading %]" data-qisutu-autocomplete-error="[% Translate.TicketToolSearchError %]">
                                <div class="qisutu-autocomplete-results qisutu-hidden" data-qisutu-autocomplete-results></div>
                                <span class="qisutu-form-hint">[% Translate.TicketToolAutocompleteHelp %]</span>
                            </div>

                            <div class="qisutu-form-field">
                                <label for="qisutu-agent-ticket-create-title-field">[% Translate.TicketArticleSubject %] *</label>
                                <input id="qisutu-agent-ticket-create-title-field" type="text" name="Title" value="[% Title %]" maxlength="500" required>
                            </div>

                            <div class="qisutu-form-field qisutu-form-field-richtext">
                                <label for="qisutu-agent-ticket-create-body">[% Translate.TicketArticleBody %] *</label>
                                <textarea id="qisutu-agent-ticket-create-body" class="qisutu-richtext" name="Body" rows="12" data-qisutu-create-body data-qisutu-body-required-message="[% Translate.AgentTicketCreateBodyRequired %]">[% Body %]</textarea>
                            </div>

                            <div class="qisutu-form-field qisutu-form-field-wide qisutu-ticket-reply-attachments">
                                <label for="qisutu-agent-ticket-create-attachments">[% Translate.TicketArticleAttachments %]</label>
                                <input id="qisutu-agent-ticket-create-attachments" type="file" name="TicketAttachment" multiple data-qisutu-attachment-input data-qisutu-attachment-max-bytes="[% AttachmentMaxSizeBytes %]" data-qisutu-attachment-max-label="[% AttachmentMaxSizeMB %] MB">
                                <div class="qisutu-ticket-reply-attachment-list" data-qisutu-attachment-list data-qisutu-attachment-remove-label="[% Translate.TicketArticleAttachmentRemove %]">
                                    <p class="qisutu-form-hint" data-qisutu-attachment-empty>[% Translate.TicketArticleAttachmentsEmpty %]</p>
                                </div>
                                <span class="qisutu-form-hint">[% Translate.TicketArticleAttachmentsHelp %] [% Translate.TicketArticleAttachmentLimitHelp %] [% AttachmentMaxSizeMB %] MB</span>
                            </div>

                            <div class="qisutu-form-field">
                                <label for="qisutu-agent-ticket-create-state">[% Translate.TicketState %]</label>
                                <select id="qisutu-agent-ticket-create-state" name="StateID" required>
                                    [% RAW.StatusOptionsHTML %]
                                </select>
                            </div>

                            <div class="qisutu-form-field">
                                <label for="qisutu-agent-ticket-create-priority">[% Translate.TicketPriority %]</label>
                                <select id="qisutu-agent-ticket-create-priority" name="PriorityID" required>
                                    [% RAW.PriorityOptionsHTML %]
                                </select>
                            </div>
                        </div>

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TicketCreateSubmit %]</button>
                        </div>
                    </form>
                    [% ELSE %]
                    <div class="qisutu-empty">
                        <strong>[% Translate.AgentTicketCreateNoQueuesTitle %]</strong>
                        <p>[% Translate.AgentTicketCreateNoQueuesText %]</p>
                    </div>
                    [% END %]
                </section>
            </section>

            <div class="qisutu-attachment-limit-overlay" data-qisutu-attachment-limit-overlay hidden>
                <div class="qisutu-attachment-limit-dialog" role="dialog" aria-modal="true" aria-labelledby="qisutu-agent-ticket-create-attachment-limit-title">
                    <h3 id="qisutu-agent-ticket-create-attachment-limit-title">[% Translate.TicketArticleAttachmentTooLargeTitle %]</h3>
                    <p data-qisutu-attachment-limit-message data-qisutu-message-template="[% Translate.TicketArticleAttachmentTooLargeMessage %]"></p>
                    <p>[% Translate.TicketArticleAttachmentTooLargeAdmin %]</p>
                    <div class="qisutu-form-actions">
                        <button class="qisutu-button qisutu-button-primary" type="button" data-qisutu-attachment-limit-close>[% Translate.TicketArticleAttachmentDialogOK %]</button>
                    </div>
                </div>
            </div>

            <script>
                window.QISUTU_STATIC_BASE = '[% StaticBase %]';
            </script>
            <script src="[% StaticBase %]/js/ckeditor5/ckeditor5.umd.js"></script>
            <script src="[% StaticBase %]/js/qisutu-richtext.js"></script>
            <script src="[% StaticBase %]/js/qisutu-agent-ticket-create.js?v=2026071101"></script>
