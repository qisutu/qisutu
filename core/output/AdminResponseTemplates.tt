%]

            <section class="qisutu-dashboard" aria-labelledby="qisutu-admin-response-template-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-admin-response-template-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                </div>

                <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>

                <form class="qisutu-localized-content-language" method="get" action="[% FormAction %]" data-localized-content-language-form>
                    <input type="hidden" name="Page" value="AdminResponseTemplates">
                    [% IF ShowCreate %]
                    <input type="hidden" name="Action" value="Create">
                    [% END %]
                    [% IF ShowEdit %]
                    <input type="hidden" name="Action" value="Edit">
                    <input type="hidden" name="TemplateID" value="[% TemplateID %]">
                    [% END %]
                    [% IF ShowTemplateQueue %]
                    <input type="hidden" name="Action" value="TemplateQueue">
                    <input type="hidden" name="TemplateID" value="[% AssignmentTemplateID %]">
                    [% END %]
                    [% IF ShowQueueTemplate %]
                    <input type="hidden" name="Action" value="QueueTemplate">
                    <input type="hidden" name="QueueID" value="[% AssignmentQueueID %]">
                    [% END %]
                    <div class="qisutu-form-field">
                        <label for="qisutu-response-template-language">[% Translate.AdminTranslationLanguage %]</label>
                        <select id="qisutu-response-template-language" name="TemplateLanguage" data-localized-content-language>
                            [% RAW.LanguageOptionsHTML %]
                        </select>
                    </div>
                    <button class="qisutu-button qisutu-button-secondary" type="submit">[% Translate.AdminFilterApply %]</button>
                </form>

                [% IF ShowList %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminResponseTemplatesList %]</h2>
                            <span class="qisutu-panel-subtitle">[% TemplateCount %] [% Translate.AdminEntries %]</span>
                        </div>
                        <div class="qisutu-panel-actions">
                            <a class="qisutu-button qisutu-button-primary" href="index.pl?Page=AdminResponseTemplates;Action=Create;TemplateLanguage=[% CurrentLanguage %]">[% Translate.AdminResponseTemplateCreate %]</a>
                        </div>
                    </div>

                    <div class="qisutu-table-wrap">
                        <table class="qisutu-table qisutu-table-compact">
                            <thead>
                                <tr>
                                    <th>[% Translate.AdminName %]</th>
                                    <th>[% Translate.AdminDescription %]</th>
                                    <th>[% Translate.AdminResponseTemplateContentPreview %]</th>
                                    <th>[% Translate.AdminResponseTemplateQueues %]</th>
                                    <th>[% Translate.AdminResponseTemplateAttachments %]</th>
                                    <th>[% Translate.AdminActive %]</th>
                                    <th>[% Translate.AdminSortOrder %]</th>
                                    <th>[% Translate.AdminAction %]</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH Template IN TemplateList %]
                                <tr>
                                    <td><a class="qisutu-table-link" href="index.pl?Page=AdminResponseTemplates;Action=Edit;TemplateID=[% Template.id %];TemplateLanguage=[% CurrentLanguage %]">[% Template.name %]</a></td>
                                    <td>[% Template.description %]</td>
                                    <td>[% Template.content_preview %]</td>
                                    <td>
                                        <a class="qisutu-table-link" href="index.pl?Page=AdminResponseTemplates;Action=TemplateQueue;TemplateID=[% Template.id %];TemplateLanguage=[% CurrentLanguage %]">[% Template.queue_names %]</a>
                                    </td>
                                    <td>[% Template.attachment_count %]</td>
                                    <td>[% Template.active_label %]</td>
                                    <td>[% Template.sort_order %]</td>
                                    <td>
                                        <form class="qisutu-inline-form" method="post" action="[% FormAction %]">
                                            <input type="hidden" name="Page" value="AdminResponseTemplates">
                                            <input type="hidden" name="Step" value="ResponseTemplateDeactivate">
                                            <input type="hidden" name="TemplateID" value="[% Template.id %]">
                                            <input type="hidden" name="TemplateLanguage" value="[% CurrentLanguage %]">
                                            <button class="qisutu-button qisutu-button-danger qisutu-button-small" type="submit">[% Translate.AdminDeactivate %]</button>
                                        </form>
                                    </td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminResponseTemplateQueueAssignmentTitle %]</h2>
                            <span class="qisutu-panel-subtitle">[% Translate.AdminResponseTemplateQueueAssignmentDescription %]</span>
                        </div>
                    </div>
                    <div class="qisutu-table-wrap">
                        <table class="qisutu-table qisutu-table-compact">
                            <thead>
                                <tr>
                                    <th>[% Translate.AdminQueue %]</th>
                                    <th>[% Translate.AdminResponseTemplatesTitle %]</th>
                                    <th>[% Translate.AdminActive %]</th>
                                    <th>[% Translate.AdminAction %]</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH Queue IN QueueList %]
                                <tr>
                                    <td><a class="qisutu-table-link" href="index.pl?Page=AdminResponseTemplates;Action=QueueTemplate;QueueID=[% Queue.id %];TemplateLanguage=[% CurrentLanguage %]">[% Queue.full_name %]</a></td>
                                    <td>[% Queue.template_names %]</td>
                                    <td>[% Queue.active_label %]</td>
                                    <td><a class="qisutu-button qisutu-button-secondary qisutu-button-small" href="index.pl?Page=AdminResponseTemplates;Action=QueueTemplate;QueueID=[% Queue.id %];TemplateLanguage=[% CurrentLanguage %]">[% Translate.AdminAssign %]</a></td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>
                    </div>
                </section>
                [% END %]

                [% IF ShowCreate %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <h2>[% Translate.AdminResponseTemplateCreate %]</h2>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminResponseTemplates;TemplateLanguage=[% CurrentLanguage %]">[% Translate.AdminBackToList %]</a>
                    </div>
                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]" enctype="multipart/form-data">
                        <input type="hidden" name="Page" value="AdminResponseTemplates">
                        <input type="hidden" name="Step" value="ResponseTemplateCreate">
                        <input type="hidden" name="TemplateLanguage" value="[% CurrentLanguage %]">

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label for="qisutu-response-template-name">[% Translate.AdminName %]</label>
                                <input id="qisutu-response-template-name" type="text" name="Name" value="[% TemplateName %]" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-response-template-description">[% Translate.AdminDescription %]</label>
                                <input id="qisutu-response-template-description" type="text" name="Description" value="[% TemplateDescription %]">
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-response-template-sort-order">[% Translate.AdminSortOrder %]</label>
                                <input id="qisutu-response-template-sort-order" type="number" name="SortOrder" value="[% TemplateSortOrder %]" min="1">
                            </div>
                        </div>

                        <div class="qisutu-form-field qisutu-form-field-richtext">
                            <label for="qisutu-response-template-content">[% Translate.AdminResponseTemplateContent %]</label>
                            <textarea id="qisutu-response-template-content" class="qisutu-richtext" name="Content">[% TemplateContent %]</textarea>
                            <p class="qisutu-form-help">[% Translate.AdminResponseTemplateContentHelp %]</p>
                        </div>

                        <div class="qisutu-form-field">
                            <label for="qisutu-response-template-attachments">[% Translate.AdminResponseTemplateAttachments %]</label>
                            <input id="qisutu-response-template-attachments" type="file" name="ResponseTemplateAttachment" multiple>
                            <p class="qisutu-form-help">[% Translate.AdminResponseTemplateAttachmentHelp %] [% AttachmentMaxSizeMB %] MB</p>
                        </div>

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminCreate %]</button>
                        </div>
                    </form>
                </section>
                [% END %]

                [% IF ShowEdit %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminResponseTemplateEdit %]</h2>
                            <span class="qisutu-panel-subtitle">[% TemplateName %]</span>
                        </div>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminResponseTemplates;TemplateLanguage=[% CurrentLanguage %]">[% Translate.AdminBackToList %]</a>
                    </div>
                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]" enctype="multipart/form-data">
                        <input type="hidden" name="Page" value="AdminResponseTemplates">
                        <input type="hidden" name="Step" value="ResponseTemplateUpdate">
                        <input type="hidden" name="TemplateID" value="[% TemplateID %]">
                        <input type="hidden" name="TemplateLanguage" value="[% CurrentLanguage %]">

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label for="qisutu-response-template-name">[% Translate.AdminName %]</label>
                                <input id="qisutu-response-template-name" type="text" name="Name" value="[% TemplateName %]" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-response-template-description">[% Translate.AdminDescription %]</label>
                                <input id="qisutu-response-template-description" type="text" name="Description" value="[% TemplateDescription %]">
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-response-template-sort-order">[% Translate.AdminSortOrder %]</label>
                                <input id="qisutu-response-template-sort-order" type="number" name="SortOrder" value="[% TemplateSortOrder %]" min="1">
                            </div>
                            <label class="qisutu-form-checkbox qisutu-admin-active-checkbox">
                                <input type="checkbox" name="Active" value="1" [% TemplateActiveChecked %]>
                                <span>[% Translate.AdminActive %]</span>
                            </label>
                        </div>

                        <div class="qisutu-form-field qisutu-form-field-richtext">
                            <label for="qisutu-response-template-content">[% Translate.AdminResponseTemplateContent %]</label>
                            <textarea id="qisutu-response-template-content" class="qisutu-richtext" name="Content">[% TemplateContent %]</textarea>
                            <p class="qisutu-form-help">[% Translate.AdminResponseTemplateContentHelp %]</p>
                        </div>

                        <div class="qisutu-form-field">
                            <label for="qisutu-response-template-attachments">[% Translate.AdminResponseTemplateAddAttachments %]</label>
                            <input id="qisutu-response-template-attachments" type="file" name="ResponseTemplateAttachment" multiple>
                            <p class="qisutu-form-help">[% Translate.AdminResponseTemplateAttachmentHelp %] [% AttachmentMaxSizeMB %] MB</p>
                        </div>

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>
                            <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminResponseTemplates;Action=TemplateQueue;TemplateID=[% TemplateID %];TemplateLanguage=[% CurrentLanguage %]">[% Translate.AdminResponseTemplateAssignQueues %]</a>
                        </div>
                    </form>

                    <div class="qisutu-admin-form-block qisutu-response-template-attachment-block">
                        <h3>[% Translate.AdminResponseTemplateExistingAttachments %]</h3>
                        [% IF HasTemplateAttachments %]
                        <div class="qisutu-response-template-admin-attachments">
                            [% FOREACH Attachment IN TemplateAttachments %]
                            <div class="qisutu-response-template-admin-attachment">
                                <span><strong>[% Attachment.filename %]</strong> · [% Attachment.size_display %] · [% Attachment.content_type %]</span>
                                <form class="qisutu-inline-form" method="post" action="[% FormAction %]">
                                    <input type="hidden" name="Page" value="AdminResponseTemplates">
                                    <input type="hidden" name="Step" value="ResponseTemplateAttachmentDelete">
                                    <input type="hidden" name="TemplateID" value="[% TemplateID %]">
                                    <input type="hidden" name="AttachmentID" value="[% Attachment.id %]">
                                    <input type="hidden" name="TemplateLanguage" value="[% CurrentLanguage %]">
                                    <button class="qisutu-button qisutu-button-danger qisutu-button-small" type="submit">[% Translate.AdminRemove %]</button>
                                </form>
                            </div>
                            [% END %]
                        </div>
                        [% ELSE %]
                        <p class="qisutu-form-hint">[% Translate.AdminResponseTemplateNoAttachments %]</p>
                        [% END %]
                    </div>
                </section>
                [% END %]

                [% IF ShowTemplateQueue %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminResponseTemplateAssignQueues %]</h2>
                            <span class="qisutu-panel-subtitle">[% AssignmentTemplateName %]</span>
                        </div>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminResponseTemplates;TemplateLanguage=[% CurrentLanguage %]">[% Translate.AdminBackToList %]</a>
                    </div>
                    <form method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="AdminResponseTemplates">
                        <input type="hidden" name="Step" value="ResponseTemplateQueueSave">
                        <input type="hidden" name="TemplateID" value="[% AssignmentTemplateID %]">
                        <input type="hidden" name="TemplateLanguage" value="[% CurrentLanguage %]">
                        <div class="qisutu-assignment-checkbox-grid">
                            [% FOREACH Queue IN QueueList %]
                            <label class="qisutu-assignment-checkbox">
                                <input type="checkbox" name="QueueID" value="[% Queue.id %]" [% Queue.assignment_checked %]>
                                <span>[% Queue.full_name %]</span>
                            </label>
                            [% END %]
                        </div>
                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>
                        </div>
                    </form>
                </section>
                [% END %]

                [% IF ShowQueueTemplate %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminResponseQueueAssignTemplates %]</h2>
                            <span class="qisutu-panel-subtitle">[% AssignmentQueueName %]</span>
                        </div>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminResponseTemplates;TemplateLanguage=[% CurrentLanguage %]">[% Translate.AdminBackToList %]</a>
                    </div>
                    <form method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="AdminResponseTemplates">
                        <input type="hidden" name="Step" value="ResponseQueueTemplateSave">
                        <input type="hidden" name="QueueID" value="[% AssignmentQueueID %]">
                        <input type="hidden" name="TemplateLanguage" value="[% CurrentLanguage %]">
                        <div class="qisutu-assignment-checkbox-grid">
                            [% FOREACH Template IN TemplateList %]
                            <label class="qisutu-assignment-checkbox">
                                <input type="checkbox" name="TemplateID" value="[% Template.id %]" [% Template.assignment_checked %]>
                                <span>[% Template.name %]</span>
                            </label>
                            [% END %]
                        </div>
                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>
                        </div>
                    </form>
                </section>
                [% END %]
            </section>
            <script>
                window.QISUTU_STATIC_BASE = '[% StaticBase %]';
            </script>
            <script src="[% StaticBase %]/js/ckeditor5/ckeditor5.umd.js"></script>
            <script src="[% StaticBase %]/js/qisutu-richtext.js"></script>
            <script src="[% StaticBase %]/js/qisutu-localized-content.js?v=[% SystemVersion %]"></script>
