[%# Qisutu CMDB CSV import profiles - AGPL-3.0-or-later %]

<section class="qisutu-dashboard" aria-labelledby="qisutu-cmdb-import-title">
    <div class="qisutu-dashboard-header"><div><h1 id="qisutu-cmdb-import-title">[% ProgramTitle %]</h1><p>[% ProgramDescription %]</p></div>[% IF ShowList %]<a class="qisutu-button qisutu-button-primary" href="index.pl?Page=AdminCMDBImports;Action=Create">[% Translate.CMDBImportProfileCreate %]</a>[% ELSE %]<a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminCMDBImports">[% Translate.AdminBackToList %]</a>[% END %]</div>
    <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div><div class="[% NoticeClass %]">[% NoticeMessage %]</div>

    [% IF ShowList %]
    <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBImportProfiles %]</h2><span class="qisutu-panel-subtitle">[% ProfileCount %] [% Translate.AdminEntries %]</span></div></div>
        [% IF ProfileCount %]<div class="qisutu-table-wrap"><table class="qisutu-table"><thead><tr><th>[% Translate.AdminName %]</th><th>[% Translate.CMDBImportSource %]</th><th>[% Translate.CMDBType %]</th><th>[% Translate.CMDBImportMappings %]</th><th>[% Translate.CMDBImportLastRun %]</th><th>[% Translate.AdminActive %]</th></tr></thead><tbody>[% FOREACH Profile IN Profiles %]<tr><td><a class="qisutu-table-link" href="index.pl?Page=AdminCMDBImports;Action=Edit;ProfileID=[% Profile.id %]">[% Profile.name %]</a></td><td>[% Profile.source_key %]</td><td>[% Profile.type_mode_label %]</td><td>[% Profile.mapping_count %]</td><td>[% Profile.last_run_at %]</td><td>[% Profile.active_label %]</td></tr>[% END %]</tbody></table></div>[% ELSE %]<div class="qisutu-empty"><strong>[% Translate.CMDBImportNoProfiles %]</strong><p>[% Translate.CMDBImportNoProfilesHelp %]</p></div>[% END %]
    </section>
    [% END %]

    [% IF ShowForm %]
    <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBImportProfile %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBImportProfileHelp %]</span></div></div>
        <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBImports"><input type="hidden" name="Step" value="ProfileSave"><input type="hidden" name="ProfileID" value="[% ProfileID %]"><div class="qisutu-admin-form-columns"><div class="qisutu-form-field"><label>[% Translate.AdminName %] *</label><input type="text" name="Name" value="[% Name %]" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportSource %] *</label><input type="text" name="SourceKey" value="[% SourceKey %]" placeholder="idoit_nightly" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportDelimiter %]</label><select name="Delimiter">[% RAW.DelimiterOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportEncoding %]</label><select name="Encoding">[% RAW.EncodingOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportTypeMode %]</label><select name="TypeMode">[% RAW.TypeModeOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportFixedType %]</label><select name="FixedTypeID">[% RAW.TypeOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportTypeColumn %]</label><input type="text" name="TypeColumn" value="[% TypeColumn %]"></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportExternalIDColumn %] *</label><input type="text" name="ExternalIDColumn" value="[% ExternalIDColumn %]" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportMaxRows %]</label><input type="number" name="MaxRows" value="[% MaxRows %]" min="1" max="1000000"></div></div><label class="qisutu-form-checkbox"><input type="checkbox" name="Active" value="1" [% ActiveChecked %]><span>[% Translate.AdminActive %]</span></label><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button></div></form>
    </section>
    [% END %]

    [% IF ShowEdit %]
    <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBImportMappings %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBImportMappingsHelp %]</span></div></div>
        [% IF HasMappings %]<div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.CMDBImportSourceColumn %]</th><th>[% Translate.CMDBImportTarget %]</th><th>[% Translate.CMDBImportPolicy %]</th><th>[% Translate.CMDBImportValueMap %]</th><th>[% Translate.AdminAction %]</th></tr></thead><tbody>[% FOREACH Mapping IN Mappings %]<tr><td>[% Mapping.source_column %]</td><td>[% Mapping.target_kind %] [% Mapping.target_key %]</td><td>[% Mapping.update_policy %]</td><td>[% Mapping.value_map_text %]</td><td><form class="qisutu-inline-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBImports"><input type="hidden" name="Step" value="MappingDelete"><input type="hidden" name="ProfileID" value="[% ProfileID %]"><input type="hidden" name="MappingID" value="[% Mapping.id %]"><button class="qisutu-button qisutu-button-danger qisutu-button-small" type="submit">[% Translate.AdminRemove %]</button></form></td></tr>[% END %]</tbody></table></div>[% END %]
        <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="AdminCMDBImports"><input type="hidden" name="Step" value="MappingSave"><input type="hidden" name="ProfileID" value="[% ProfileID %]"><div class="qisutu-admin-form-columns"><div class="qisutu-form-field"><label>[% Translate.CMDBImportSourceColumn %] *</label><input type="text" name="SourceColumn" required></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportTarget %]</label><select name="TargetKind">[% RAW.TargetKindOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportTargetKey %]</label><input type="text" name="TargetKey"><span class="qisutu-form-hint">[% Translate.CMDBImportTargetKeyHelp %]</span></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportPolicy %]</label><select name="UpdatePolicy">[% RAW.UpdatePolicyOptionsHTML %]</select></div><div class="qisutu-form-field"><label>[% Translate.CMDBDefaultValue %]</label><input type="text" name="DefaultValue"></div><div class="qisutu-form-field"><label>[% Translate.AdminSortOrder %]</label><input type="number" name="SortOrder" value="1000" min="0"></div></div><div class="qisutu-form-field"><label>[% Translate.CMDBImportValueMap %]</label><textarea name="ValueMapText" rows="5" placeholder="Quellwert|Zielwert"></textarea><span class="qisutu-form-hint">[% Translate.CMDBImportValueMapHelp %]</span></div><label class="qisutu-form-checkbox"><input type="checkbox" name="IsRequired" value="1"><span>[% Translate.CMDBRequired %]</span></label><div class="qisutu-form-actions"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminCreate %]</button></div></form>
    </section>

    <section class="qisutu-panel"><div class="qisutu-panel-header"><div><h2>[% Translate.CMDBImportRun %]</h2><span class="qisutu-panel-subtitle">[% Translate.CMDBImportRunHelp %]</span></div></div><form class="qisutu-admin-form" method="post" action="[% FormAction %]" enctype="multipart/form-data"><input type="hidden" name="Page" value="AdminCMDBImports"><input type="hidden" name="Step" value="ImportRun"><input type="hidden" name="ProfileID" value="[% ProfileID %]"><div class="qisutu-form-field"><label>[% Translate.CMDBCSVFile %]</label><input type="file" name="CMDBCSV" accept=".csv,text/csv" required></div><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.CMDBImportCSV %]</button></form>
        [% IF HasRuns %]<div class="qisutu-table-wrap"><table class="qisutu-table qisutu-table-compact"><thead><tr><th>[% Translate.CMDBImportStarted %]</th><th>[% Translate.CMDBImportFile %]</th><th>[% Translate.CMDBImportRunStatus %]</th><th>[% Translate.CMDBImportCreated %]</th><th>[% Translate.CMDBImportUpdated %]</th><th>[% Translate.CMDBImportFailed %]</th></tr></thead><tbody>[% FOREACH Run IN Runs %]<tr><td>[% Run.started_at %]</td><td>[% Run.file_name %]</td><td>[% Run.status %]</td><td>[% Run.created_count %]</td><td>[% Run.updated_count %]</td><td>[% Run.failed_count %]<small class="qisutu-table-secondary">[% Run.error_text %]</small></td></tr>[% END %]</tbody></table></div>[% END %]
    </section>
    [% END %]
</section>
