along with Qisutu. If not, see <https://www.gnu.org/licenses/>.

SPDX-FileCopyrightText: 2026 Franziska Steps
SPDX-License-Identifier: AGPL-3.0-or-later
%]

            <section class="qisutu-dashboard qisutu-mail-account-page" aria-labelledby="qisutu-admin-imap-title">
                <div class="qisutu-dashboard-header">
                    <div>
                        <h1 id="qisutu-admin-imap-title">[% ProgramTitle %]</h1>
                        <p>[% ProgramDescription %]</p>
                    </div>
                </div>

                <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>
                <div class="[% NoticeClass %]">[% NoticeMessage %]</div>

                [% IF ShowList %]
                <section class="qisutu-panel qisutu-mail-account-selector" aria-labelledby="qisutu-mail-account-selector-title">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2 id="qisutu-mail-account-selector-title">[% Translate.AdminMailAccountSelectTitle %]</h2>
                            <span class="qisutu-panel-subtitle">[% Translate.AdminMailAccountSelectDescription %]</span>
                        </div>
                    </div>

                    <div class="qisutu-mail-account-choice-grid">
                        <a class="qisutu-mail-account-choice" href="index.pl?Page=AdminPostmasterIMAPAccount">
                            <span class="qisutu-mail-account-choice-icon" aria-hidden="true">IMAP</span>
                            <strong>[% Translate.AdminMailTypeStandardIMAP %]</strong>
                            <span>[% Translate.AdminStandardIMAPChoiceDescription %]</span>
                            <em>[% Translate.AdminMailAccountCreateAction %] →</em>
                        </a>
                        <a class="qisutu-mail-account-choice" href="index.pl?Page=AdminPostmasterMicrosoft365">
                            <span class="qisutu-mail-account-choice-icon" aria-hidden="true">M365</span>
                            <strong>[% Translate.AdminMailTypeMicrosoft365 %]</strong>
                            <span>[% Translate.AdminMicrosoft365ChoiceDescription %]</span>
                            <em>[% Translate.AdminMailAccountCreateAction %] →</em>
                        </a>
                        <a class="qisutu-mail-account-choice" href="index.pl?Page=AdminPostmasterGoogleMail">
                            <span class="qisutu-mail-account-choice-icon" aria-hidden="true">G</span>
                            <strong>[% Translate.AdminMailTypeGoogle %]</strong>
                            <span>[% Translate.AdminGoogleMailChoiceDescription %]</span>
                            <em>[% Translate.AdminMailAccountCreateAction %] →</em>
                        </a>
                    </div>
                </section>

                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% Translate.AdminPostmasterIMAPAccountsList %]</h2>
                            <span class="qisutu-panel-subtitle">[% AccountCount %] [% Translate.AdminEntries %]</span>
                        </div>
                    </div>

                    <div class="qisutu-table-wrap">
                        <table class="qisutu-table qisutu-table-compact">
                            <thead>
                                <tr>
                                    <th>[% Translate.AdminName %]</th>
                                    <th>[% Translate.AdminEmail %]</th>
                                    <th>[% Translate.AdminAccountType %]</th>
                                    <th>[% Translate.AdminTargetQueue %]</th>
                                    <th>[% Translate.AdminHost %]</th>
                                    <th>[% Translate.AdminConnectionStatus %]</th>
                                    <th>[% Translate.AdminActive %]</th>
                                    <th>[% Translate.AdminAction %]</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH Account IN AccountList %]
                                <tr>
                                    <td><a class="qisutu-table-link" href="[% Account.edit_url %]">[% Account.name %]</a></td>
                                    <td>[% Account.email %]</td>
                                    <td>[% Account.type_label %]</td>
                                    <td>[% Account.queue_name %]</td>
                                    <td>[% Account.imap_host %]</td>
                                    <td>[% Account.connection_label %]</td>
                                    <td>[% Account.active_label %]</td>
                                    <td>
                                        <div class="qisutu-mail-account-actions">
                                            <form class="qisutu-inline-form" method="post" action="[% FormAction %]">
                                                <input type="hidden" name="Page" value="AdminPostmasterIMAPAccounts">
                                                <input type="hidden" name="Step" value="[% Account.toggle_step %]">
                                                <input type="hidden" name="AccountID" value="[% Account.id %]">
                                                <button class="qisutu-button [% Account.toggle_button_class %] qisutu-button-small" type="submit">[% Account.toggle_label %]</button>
                                            </form>
                                            <button
                                                class="qisutu-button qisutu-button-danger qisutu-button-small [% Account.delete_class %]"
                                                type="button"
                                                data-qisutu-mail-delete-open
                                                data-qisutu-mail-delete-id="[% Account.id %]"
                                                data-qisutu-mail-delete-name="[% Account.name %]">[% Translate.AdminMailAccountDelete %]</button>
                                        </div>
                                    </td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>
                    </div>
                </section>

                <div class="qisutu-mail-delete-overlay" data-qisutu-mail-delete-overlay hidden aria-hidden="true">
                    <section class="qisutu-mail-delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="qisutu-mail-delete-title" aria-describedby="qisutu-mail-delete-description">
                        <h3 id="qisutu-mail-delete-title">[% Translate.AdminMailAccountDeleteTitle %]</h3>
                        <p id="qisutu-mail-delete-description">[% Translate.AdminMailAccountDeleteWarning %]</p>
                        <p class="qisutu-mail-delete-account" data-qisutu-mail-delete-account></p>
                        <p>[% Translate.AdminMailAccountDeleteCredentialsWarning %]</p>
                        <form method="post" action="[% FormAction %]" data-qisutu-mail-delete-form>
                            <input type="hidden" name="Page" value="AdminPostmasterIMAPAccounts">
                            <input type="hidden" name="Step" value="IMAPAccountDelete">
                            <input type="hidden" name="AccountID" value="" data-qisutu-mail-delete-id-input>
                            <div class="qisutu-form-actions qisutu-mail-delete-actions">
                                <button class="qisutu-button qisutu-button-secondary" type="button" data-qisutu-mail-delete-close>[% Translate.AdminCancel %]</button>
                                <button class="qisutu-button qisutu-button-danger" type="submit">[% Translate.AdminMailAccountDeleteConfirm %]</button>
                            </div>
                        </form>
                    </section>
                </div>
                [% END %]

                [% IF ShowForm %]
                <section class="qisutu-panel">
                    <div class="qisutu-panel-header">
                        <div>
                            <h2>[% FormTitle %]</h2>
                            [% IF ShowEdit %]
                            <span class="qisutu-panel-subtitle">[% AccountName %]</span>
                            [% END %]
                        </div>
                        <a class="qisutu-button qisutu-button-secondary" href="index.pl?Page=AdminPostmasterIMAPAccounts">[% Translate.AdminBackToList %]</a>
                    </div>

                    [% IF IsMicrosoft %]
                    <div class="qisutu-mail-provider-info">
                        <strong>[% Translate.AdminMailTypeMicrosoft365 %]</strong>
                        <span>[% Translate.AdminMicrosoft365ProviderHint %]</span>
                    </div>
                    [% END %]
                    [% IF IsGoogle %]
                    <div class="qisutu-mail-provider-info">
                        <strong>[% Translate.AdminMailTypeGoogle %]</strong>
                        <span>[% Translate.AdminGoogleMailProviderHint %]</span>
                    </div>
                    [% END %]

                    <form class="qisutu-admin-form qisutu-admin-form-wide" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="[% CurrentPage %]">
                        <input type="hidden" name="Step" value="[% FormStep %]">
                        <input type="hidden" name="AccountKind" value="[% AccountKind %]">
                        [% IF ShowEdit %]
                        <input type="hidden" name="Action" value="Edit">
                        <input type="hidden" name="AccountID" value="[% AccountID %]">
                        [% END %]

                        <div class="qisutu-admin-form-columns">
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-name">[% Translate.AdminName %]</label>
                                <input id="qisutu-mail-name" type="text" name="Name" value="[% AccountName %]" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-email">[% Translate.AdminEmail %]</label>
                                <input id="qisutu-mail-email" type="email" name="Email" value="[% AccountEmail %]" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-queue">[% Translate.AdminTargetQueue %]</label>
                                <select id="qisutu-mail-queue" name="QueueID" required>
                                    <option value="">[% Translate.AdminNoSelection %]</option>
                                    [% RAW.QueueOptionsHTML %]
                                </select>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-username">[% Translate.AdminUsername %]</label>
                                <input id="qisutu-mail-username" type="text" name="IMAPUsername" value="[% AccountIMAPUsername %]" required>
                            </div>

                            [% IF IsStandard %]
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-security">[% Translate.AdminIMAPSecurity %]</label>
                                <select id="qisutu-mail-security" name="IMAPSecurity" data-qisutu-port-target="IMAPPort">
                                    [% RAW.IMAPSecurityOptionsHTML %]
                                </select>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-port">[% Translate.AdminPort %]</label>
                                <input id="qisutu-mail-port" type="number" name="IMAPPort" value="[% AccountIMAPPort %]" min="1" max="65535" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-host">[% Translate.AdminHost %]</label>
                                <input id="qisutu-mail-host" type="text" name="IMAPHost" value="[% AccountIMAPHost %]" required>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-password">[% Translate.AdminPassword %]</label>
                                [% IF ShowEdit %]
                                <input id="qisutu-mail-password" type="password" name="IMAPPassword" placeholder="[% Translate.AdminPasswordKeep %]" autocomplete="new-password">
                                [% ELSE %]
                                <input id="qisutu-mail-password" type="password" name="IMAPPassword" required autocomplete="new-password">
                                [% END %]
                            </div>
                            [% END %]

                            <div class="qisutu-form-field">
                                <label>[% Translate.AdminMailCertificateVerification %]</label>
                                <label class="qisutu-checkbox-label">
                                    <input type="checkbox" name="IMAPVerifyCertificate" value="1" [% AccountIMAPVerifyCertificateChecked %]>
                                    [% Translate.AdminMailVerifyServerCertificate %]
                                </label>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-imap-ca-file">[% Translate.AdminMailCAFile %]</label>
                                <input id="qisutu-imap-ca-file" type="text" name="IMAPCAFile" value="[% AccountIMAPCAFile %]" placeholder="/etc/ssl/certs/company-ca.pem">
                                <small>[% Translate.AdminMailCAFileHint %]</small>
                            </div>

                            [% IF IsMicrosoft %]
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-host">[% Translate.AdminHost %]</label>
                                <input id="qisutu-mail-host" type="text" value="[% MicrosoftIMAPHost %]" readonly>
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-oauth-tenant">[% Translate.AdminOAuthTenantID %]</label>
                                <input id="qisutu-oauth-tenant" type="text" name="OAuthTenantID" value="[% AccountOAuthTenantID %]" required>
                            </div>
                            [% END %]

                            [% IF IsGoogle %]
                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-host">[% Translate.AdminHost %]</label>
                                <input id="qisutu-mail-host" type="text" value="[% GoogleIMAPHost %]" readonly>
                            </div>
                            [% END %]

                            [% IF IsMicrosoft %]
                            <div class="qisutu-form-field">
                                <label for="qisutu-oauth-client-id">[% Translate.AdminOAuthClientID %]</label>
                                <input id="qisutu-oauth-client-id" type="text" name="OAuthClientID" value="[% AccountOAuthClientID %]" required autocomplete="off">
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-oauth-client-secret">[% Translate.AdminOAuthClientSecret %]</label>
                                [% IF ShowEdit %]
                                <input id="qisutu-oauth-client-secret" type="password" name="OAuthClientSecret" placeholder="[% Translate.AdminPasswordKeep %]" autocomplete="new-password">
                                [% ELSE %]
                                <input id="qisutu-oauth-client-secret" type="password" name="OAuthClientSecret" required autocomplete="new-password">
                                [% END %]
                            </div>
                            [% END %]

                            [% IF IsGoogle %]
                            <div class="qisutu-form-field">
                                <label for="qisutu-oauth-client-id">[% Translate.AdminOAuthClientID %]</label>
                                <input id="qisutu-oauth-client-id" type="text" name="OAuthClientID" value="[% AccountOAuthClientID %]" required autocomplete="off">
                            </div>
                            <div class="qisutu-form-field">
                                <label for="qisutu-oauth-client-secret">[% Translate.AdminOAuthClientSecret %]</label>
                                [% IF ShowEdit %]
                                <input id="qisutu-oauth-client-secret" type="password" name="OAuthClientSecret" placeholder="[% Translate.AdminPasswordKeep %]" autocomplete="new-password">
                                [% ELSE %]
                                <input id="qisutu-oauth-client-secret" type="password" name="OAuthClientSecret" required autocomplete="new-password">
                                [% END %]
                            </div>
                            [% END %]

                            [% IF IsMicrosoft %]
                            <div class="qisutu-form-field qisutu-form-field-wide">
                                <label for="qisutu-oauth-redirect-uri">[% Translate.AdminOAuthRedirectURI %]</label>
                                <input id="qisutu-oauth-redirect-uri" type="text" value="[% OAuthRedirectURI %]" readonly>
                                <small>[% Translate.AdminOAuthRedirectURIHelp %]</small>
                            </div>
                            [% END %]
                            [% IF IsGoogle %]
                            <div class="qisutu-form-field qisutu-form-field-wide">
                                <label for="qisutu-oauth-redirect-uri">[% Translate.AdminOAuthRedirectURI %]</label>
                                <input id="qisutu-oauth-redirect-uri" type="text" value="[% OAuthRedirectURI %]" readonly>
                                <small>[% Translate.AdminOAuthRedirectURIHelp %]</small>
                            </div>
                            [% END %]

                            <div class="qisutu-form-field">
                                <label for="qisutu-mail-sort">[% Translate.AdminSortOrder %]</label>
                                <input id="qisutu-mail-sort" type="number" name="SortOrder" value="[% AccountSortOrder %]" min="1" required>
                            </div>
                            <label class="qisutu-form-checkbox qisutu-admin-active-checkbox">
                                <input type="checkbox" name="Active" value="1" [% AccountActiveChecked %]>
                                <span>[% Translate.AdminActive %]</span>
                            </label>
                        </div>

                        <div class="qisutu-form-actions">
                            <button class="qisutu-button qisutu-button-primary" type="submit">[% SubmitLabel %]</button>
                        </div>
                    </form>
                </section>

                [% IF ShowEdit %]
                <section class="qisutu-panel qisutu-mail-connection-panel">
                    <div class="qisutu-panel-header">
                        <h2>[% Translate.AdminConnectionStatus %]</h2>
                    </div>
                    <dl class="qisutu-mail-connection-details">
                        <div><dt>[% Translate.AdminConnectionStatus %]</dt><dd>[% AccountConnectionLabel %]</dd></div>
                        <div><dt>[% Translate.AdminLastConnectionTest %]</dt><dd>[% AccountLastCheckAt %]</dd></div>
                        <div><dt>[% Translate.AdminConnectionMessage %]</dt><dd>[% AccountLastCheckMessage %]</dd></div>
                        [% IF IsMicrosoft %]
                        <div><dt>[% Translate.AdminOAuthTokenExpires %]</dt><dd>[% AccountTokenExpires %]</dd></div>
                        [% END %]
                        [% IF IsGoogle %]
                        <div><dt>[% Translate.AdminOAuthTokenExpires %]</dt><dd>[% AccountTokenExpires %]</dd></div>
                        [% END %]
                    </dl>
                    <form class="qisutu-inline-form" method="post" action="[% FormAction %]">
                        <input type="hidden" name="Page" value="[% CurrentPage %]">
                        <input type="hidden" name="Step" value="IMAPAccountTest">
                        <input type="hidden" name="Action" value="Edit">
                        <input type="hidden" name="AccountID" value="[% AccountID %]">
                        <button class="qisutu-button qisutu-button-secondary" type="submit">[% Translate.AdminTestIMAP %]</button>
                    </form>
                </section>
                [% END %]
                [% END %]
            </section>

            <script src="[% StaticBase %]/js/qisutu-mail-account.js?v=2026071701"></script>
