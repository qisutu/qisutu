        <section class="qisutu-login" aria-labelledby="qisutu-two-factor-recovery-title">
            <div class="qisutu-login-panel">
                <div class="qisutu-login-brand">
                    <div class="qisutu-login-logo">
                        <img src="[% StaticBase %]/img/logo.png" alt="Qisutu">
                    </div>
                    <div>
                        <h1>[% SystemName %]</h1>
                        <p>[% Translate.LoginIntro %]</p>
                    </div>
                </div>

                <div class="qisutu-login-section-header">
                    <h2 id="qisutu-two-factor-recovery-title">[% Translate.TwoFactorRecoveryCodesTitle %]</h2>
                    <p>[% Translate.TwoFactorRecoveryCodesDescription %]</p>
                </div>

                <ul class="qisutu-recovery-code-list qisutu-login-recovery-code-list">[% RAW.RecoveryCodesHTML %]</ul>

                <div class="qisutu-login-notice">
                    <p>[% Translate.TwoFactorRecoveryCodesOnce %]</p>
                </div>

                <a class="qisutu-login-button qisutu-login-button-link qisutu-login-two-factor-continue" href="[% FormAction %]">[% Translate.TwoFactorContinue %]</a>
            </div>
        </section>
