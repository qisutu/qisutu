<div class="qisutu-dashboard">
    <header class="qisutu-dashboard-header">
        <div>
            <h1 id="qisutu-customer-preferences-title">[% ProgramTitle %]</h1>
            <p>[% ProgramDescription %]</p>
        </div>
    </header>

    <div class="qisutu-form-error [% ErrorClass %]">[% ErrorMessage %]</div>
    <div class="qisutu-form-error qisutu-form-success [% SuccessClass %]">[% SuccessMessage %]</div>

    <form class="qisutu-admin-form" method="post" action="[% FormAction %]">
        <input type="hidden" name="Page" value="CustomerPreferences">
        <input type="hidden" name="Step" value="PreferenceSave">

        <section class="qisutu-panel">
            <div class="qisutu-panel-header">
                <h2>[% Translate.PreferencesGeneral %]</h2>
            </div>

            <div class="qisutu-admin-form-columns">
                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesLanguage %]</label>
                    <select name="PreferenceLanguage">
                        [% RAW.LanguageOptions %]
                    </select>
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesTimezone %]</label>
                    <select name="Timezone">
                        [% RAW.TimezoneOptions %]
                    </select>
                </div>
            </div>
        </section>

        <section class="qisutu-panel">
            <div class="qisutu-panel-header">
                <h2>[% Translate.PreferencesPassword %]</h2>
            </div>

            <div class="qisutu-admin-form-columns">
                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesCurrentPassword %]</label>
                    <input type="password" name="CurrentPassword" value="" autocomplete="current-password">
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesNewPassword %]</label>
                    <input type="password" name="NewPassword" value="" autocomplete="new-password">
                </div>

                <div class="qisutu-form-field">
                    <label>[% Translate.PreferencesNewPasswordRepeat %]</label>
                    <input type="password" name="NewPasswordRepeat" value="" autocomplete="new-password">
                </div>
            </div>
        </section>

        <div class="qisutu-form-actions">
            <button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.AdminSave %]</button>
        </div>
    </form>
    <section class="qisutu-panel">
        <div class="qisutu-panel-header"><div><h2>[% Translate.TwoFactorTitle %]</h2><span class="qisutu-panel-subtitle">[% Translate.TwoFactorPreferencesDescription %]</span></div></div>
        [% IF ShowRecoveryCodes %]
        <div class="qisutu-form-error qisutu-form-success"><strong>[% Translate.TwoFactorRecoveryCodesTitle %]</strong><p>[% Translate.TwoFactorRecoveryCodesDescription %]</p><ul class="qisutu-recovery-code-list">[% RAW.RecoveryCodesHTML %]</ul><p>[% Translate.TwoFactorRecoveryCodesOnce %]</p></div>
        [% END %]
        [% IF TwoFactorSetup %]
        <div class="qisutu-two-factor-setup-grid">
            <div>
                <p>[% Translate.TwoFactorSetupScanHint %]</p>
                <div class="qisutu-two-factor-qr" data-qisutu-two-factor-uri="[% TwoFactorProvisioningURI %]" data-qisutu-two-factor-label="[% Translate.TwoFactorQRCodeLabel %]"></div>
            </div>
            <div>
                <p>[% Translate.TwoFactorSetupManualHint %]</p>
                <code class="qisutu-two-factor-secret">[% TwoFactorSecret %]</code>
            </div>
        </div>
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="CustomerPreferences"><input type="hidden" name="Step" value="TwoFactorEnable"><div class="qisutu-form-field"><label>[% Translate.TwoFactorAuthenticatorCode %]</label><input type="text" name="TwoFactorCode" inputmode="numeric" autocomplete="one-time-code" required></div><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TwoFactorEnable %]</button></form>
        <script src="[% StaticBase %]/js/qrcode-generator/qrcode.js?v=2.0.4"></script>
        <script src="[% StaticBase %]/js/qisutu-two-factor.js?v=2026072001"></script>
        [% ELSE %]
        [% IF TwoFactorEnabled %]
        <p>[% Translate.TwoFactorEnabledText %] [% TwoFactorRecoveryRemaining %]</p>
        <div class="qisutu-admin-form-columns">
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="CustomerPreferences"><input type="hidden" name="Step" value="TwoFactorRecoveryRegenerate"><div class="qisutu-form-field"><label>[% Translate.TwoFactorAuthenticatorCode %]</label><input type="text" name="TwoFactorCode" inputmode="numeric" required></div><button class="qisutu-button qisutu-button-secondary" type="submit">[% Translate.TwoFactorRecoveryRegenerate %]</button></form>
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="CustomerPreferences"><input type="hidden" name="Step" value="TwoFactorDisable"><div class="qisutu-form-field"><label>[% Translate.TwoFactorCodeOrRecoveryCode %]</label><input type="text" name="TwoFactorCode" required></div><button class="qisutu-button qisutu-button-danger" type="submit">[% Translate.TwoFactorDisable %]</button></form>
        </div>
        [% ELSE %]
        <form class="qisutu-admin-form" method="post" action="[% FormAction %]"><input type="hidden" name="Page" value="CustomerPreferences"><input type="hidden" name="Step" value="TwoFactorStart"><button class="qisutu-button qisutu-button-primary" type="submit">[% Translate.TwoFactorStart %]</button></form>
        [% END %]
        [% END %]
    </section>
</div>
